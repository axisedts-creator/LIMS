# LIMS environment template (T0D-DEP-01, LD-173 rule 2): NAMES ONLY. Never put a value in this file.
# Copy to .env (git-ignored) or set the names in the host's secret store. *_KEY_FILE names hold a PATH to a mounted
# secret file, never the secret itself. LIMS_CORE_ENV values: dev | ci | staging | production.
# Scope: the core keys of services/api/src/core/config.ts (02-TRD s11), the process keys of the worker and the web
# BFF, plus Storage and GoTrue. Module tuning keys (LIMS_<MODULE>_*) that have code defaults are not listed; module
# secrets and paths without a default are listed below.

# ===== api =====
# required, all (dev|ci|staging|production). config.ts loadConfig; boot fails if missing.
LIMS_CORE_ENV=

# optional, all; on|off, default on in dev/ci/staging, off in production.
LIMS_CORE_RESPONSE_VALIDATION=

# optional, ci only (0|1, default 0); ignored in dev, staging, production.
LIMS_CORE_LOAD_SAMPLE_MODULE=

# optional, all; fatal|error|warn|info|debug|trace|silent, default info.
LIMS_CORE_LOG_LEVEL=

# required, all, as soon as any bearerJwt operation is mounted (config.ts: all four JWT keys or none). HS256|ES256|RS256.
LIMS_CORE_JWT_ALG=

# required, all (with the other JWT keys). Exact `iss` claim of the access tokens.
LIMS_CORE_JWT_ISSUER=

# required, all (with the other JWT keys). Expected `aud` claim.
LIMS_CORE_JWT_AUDIENCE=

# required, all (with the other JWT keys). Path to the verification key file (HS256 secret or ES256/RS256 public key PEM).
LIMS_CORE_JWT_KEY_FILE=

# optional, all; path to the staff-web BFF key file (X-Lims-Bff-Key). Unset = staff-web BFF calls are refused.
LIMS_WEB_BFF_KEY_FILE=

# optional, all; path to the partner BFF key file.
LIMS_PARTNER_BFF_KEY_FILE=

# optional, all; path to the portal BFF key file.
LIMS_PORTAL_BFF_KEY_FILE=

# optional, all; comma list of trusted proxy CIDRs; unset = no trusted peer.
LIMS_CORE_TRUSTED_PROXY_CIDRS=

# optional, all; whole-request retries on 40001/40P01, default 3.
LIMS_CORE_TX_RETRY_MAX=

# optional, all; operationId list overriding the identity-auth allowlist (D-212). Leave unset.
LIMS_CORE_IDENTITY_AUTH_OPS=

# optional, all; operationId list overriding the withTenantScope allowlist (D-214). Leave unset.
LIMS_CORE_WITH_TENANT_SCOPE_OPS=

# optional, all; internal /metrics + /health/live port, default 9464.
LIMS_CORE_METRICS_PORT=

# optional in dev, ci; required in staging, production for any non-public operation. Unset = no DB pool.
LIMS_CORE_DATABASE_URL=

# optional, all; DB pool size, default 20.
LIMS_CORE_DB_POOL_MAX=

# optional, all; ms, default 5000.
LIMS_CORE_STATEMENT_TIMEOUT_MS=

# optional, all; ms, default 3000.
LIMS_CORE_LOCK_TIMEOUT_MS=

# optional, dev and ci only (fakes load only there); comma list of ports forced to their fake.
LIMS_CORE_FAKE_PORTS=

# optional, all; postgres|redis, default postgres (redis is not wired in the API yet).
LIMS_CORE_RATELIMIT_BACKEND=

# optional, all; only with LIMS_CORE_RATELIMIT_BACKEND=redis.
LIMS_CORE_REDIS_URL=

# required, all, whenever LIMS_CORE_DATABASE_URL is set (pipeline/boot.ts). Path to the rate-limit HMAC key file.
LIMS_CORE_RATELIMIT_KEY_FILE=

# optional, all; per-tenant requests per second, default 100.
LIMS_CORE_TENANT_RPS=

# optional, all; per-tenant burst, default 200.
LIMS_CORE_TENANT_BURST=

# optional, all at boot (Storage is not wired into the API yet); required by db/provisioning/create-storage-buckets.mjs.
# Storage API base URL incl. the /storage/v1 prefix, no default.
LIMS_CORE_STORAGE_URL=

# optional, all at boot; required by create-storage-buckets.mjs and by ctx.storage once wired. Path to the Storage key file.
LIMS_CORE_STORAGE_KEY_FILE=

# optional, all at boot; required by the identity GoTrue gateway (identity:bootstrap-platform-admin). GoTrue base URL.
LIMS_IDENTITY_GOTRUE_URL=

# optional, all at boot; required by the identity GoTrue gateway. GoTrue service key.
LIMS_IDENTITY_GOTRUE_SERVICE_KEY=

# optional, all; upload scanner URL (core/uploads/scan.ts).
LIMS_CORE_SCANNER_URL=

# optional at boot; required in staging, production for portal links / payment return URLs (reporting, engagement,
# payments config; RenderPort fails closed when unset). Portal origin.
LIMS_ORIGIN_PORTAL=

# optional at boot; required in staging, production for staff links / payment return URLs (payments config,
# analytics schedule.service throws when unset). Staff-web origin.
LIMS_ORIGIN_STAFF_WEB=

# optional at boot; required, all, for staff login and user/tenant creation (identity auth.service.ts, user.http.ts,
# tenant.http.ts throw common.internal when unset). Email HMAC key, no default.
LIMS_IDENTITY_EMAIL_HMAC_KEY=

# optional at boot; required, all, for sessions/MFA (auth-events.repo.ts, mfa.repo.ts fail closed when unset).
# JSON key map {"<key_id>":"<base64 32 bytes>"}; the last id encrypts. Never commit a value.
LIMS_IDENTITY_TOKEN_ENC_KEYS=

# required, all, when reporting config loads (reporting/config.ts fails when unset or unreadable). Path to the portal OTP HMAC key file.
LIMS_REPORTING_OTP_HMAC_KEY_FILE=

# optional in dev, ci; required in staging, production (instruments/config.ts throws when unset). Path to the Ed25519 PKCS#8 PEM config-signing key.
LIMS_INSTRUMENTS_CONFIG_SIGNING_KEY_FILE=

# optional in dev, ci; required in staging, production (instruments/config.ts). Key id of the config-signing key.
LIMS_INSTRUMENTS_CONFIG_SIGNING_KEY_ID=

# optional in dev, ci; required in staging, production (instruments/config.ts). Instrument agent releases directory.
LIMS_INSTRUMENTS_RELEASES_DIR=

# ===== worker =====
# required, all (dev|ci|staging|production). Direct Postgres URL of lims_worker; boot fails if missing.
LIMS_CORE_WORKER_DATABASE_URL=

# optional, all; log field env, default dev.
LIMS_CORE_ENV=

# optional, all; log field version, default 0.0.0.
LIMS_CORE_VERSION=

# optional, all; default info.
LIMS_CORE_LOG_LEVEL=

# optional, all; /metrics + /health/live port, default 9464.
LIMS_CORE_METRICS_PORT=

# optional, all; Graphile Worker concurrency, default 10.
LIMS_CORE_WORKER_CONCURRENCY=

# optional, all; SIGTERM drain seconds, default 55.
LIMS_CORE_SHUTDOWN_GRACE_S=

# required in staging, production; optional in dev, ci. Portal origin used for report/payment links (fails closed when unset).
LIMS_ORIGIN_PORTAL=

# optional at boot; required, all, for the reporting send_portal_otp task (fails when unset). Path to the portal OTP HMAC key file.
LIMS_REPORTING_OTP_HMAC_KEY_FILE=

# optional at boot; required, all, for instruments config jobs (jobs/instruments/configs.ts throws when unset). Signing key file path.
LIMS_INSTRUMENTS_CONFIG_SIGNING_KEY_FILE=

# optional at boot; required, all, for instruments config jobs (jobs/instruments/configs.ts). Signing key id.
LIMS_INSTRUMENTS_CONFIG_SIGNING_KEY_ID=

# optional at boot; required, all, for the billing export_tenant task (fails when unset). Base64 of 32 bytes. Never commit a value.
LIMS_BILLING_EXPORT_KEY=

# ===== web =====
# required in staging, production (selects the C2 session resolver); optional in dev, ci.
LIMS_CORE_ENV=

# required in staging, production; optional in dev, ci (unset = in-memory dev session provider). API origin.
LIMS_ORIGIN_API=

# required in staging, production (C2 resolveSession); optional in dev, ci. Path to the staff-web BFF key file.
LIMS_WEB_BFF_KEY_FILE=

# optional, all; staff-web origin used by middleware.ts.
LIMS_ORIGIN_STAFF_WEB=
