    WHERE e.tenant_id = $1 AND e.party_kind = $2 AND e.party_id = $3 AND e.entry_date BETWEEN $4::date AND $5::date AND e.status <> 'held'
    ORDER BY e.entry_date, e.receipt_seq LIMIT $6`, [p.tenantId, p.partyKind, p.partyId, p.from, p.to, p.limit])).rows;
}
/** Signed sum over every entry of the party (no date), as text. */
export async function outstanding(tx: Tx, p: Party): Promise<string> {
  return (await tx.query(`SELECT COALESCE(SUM(CASE e.entry_type WHEN 'credit' THEN e.amount_paisa ELSE -e.amount_paisa END), 0)::text AS s FROM billing.account_ledger_entries e
    WHERE e.tenant_id = $1 AND e.party_kind = $2 AND e.party_id = $3 AND e.status <> 'held'`, [p.tenantId, p.partyKind, p.partyId])).rows[0].s;
}

// ---------------------------------------------------------------- T0B-FINCTRL-1 (LD-321) hold / release
/** The tenant ledger lock of nextReceiptSeq: a hold / release and a reversal of the same entry never interleave. */
export async function lockLedger(tx: Tx, tenantId: string): Promise<void> {
  await tx.query(\"SELECT pg_advisory_xact_lock(hashtextextended('billing.account_ledger_entries:' || $1::text, 0))\", [tenantId]);
}
const ENTRY_RETURNING = `id, centre_id, party_kind, party_id, entry_date::text AS entry_date, account_particular_id, entry_type, amount_paisa::text AS amount_paisa,
  payment_mode, bank_name, reference_no, payment_details, comments, reverses_entry_id, receipt_no, receipt_seq::text AS receipt_seq,
  created_by, last_modified_by, created_at, status, held_reason, held_by, held_at, released_by, released_at, fiscal_year_label`;
/** submitted -> held of an unreversed entry; undefined when the entry is not (or no longer) in that state. Only status, the hold columns and the stamp are named (DB guard). */
export async function holdEntry(tx: Tx, a: { tenantId: string; id: string; reason: string; actorId: string; at: string }): Promise<Row | undefined> {
  return (await tx.query(`UPDATE billing.account_ledger_entries e SET status = 'held', held_reason = $3, held_by = $4, held_at = $5::timestamptz, released_by = NULL, released_at = NULL,
      last_modified_by = $4, updated_at = now()
    WHERE e.tenant_id = $1 AND e.id = $2 AND e.status = 'submitted'
      AND NOT EXISTS (SELECT 1 FROM billing.account_ledger_entries r WHERE r.tenant_id = e.tenant_id AND r.reverses_entry_id = e.id)
    RETURNING ${ENTRY_RETURNING}`, [a.tenantId, a.id, a.reason, a.actorId, a.at])).rows[0];
}
/** held -> submitted (the only earlier status a hold can come from); the held_* columns stay as history. */
export async function releaseEntry(tx: Tx, a: { tenantId: string; id: string; actorId: string; at: string }): Promise<Row | undefined> {
  return (await tx.query(`UPDATE billing.account_ledger_entries SET status = 'submitted', released_by = $3, released_at = $4::timestamptz, last_modified_by = $3, updated_at = now()
    WHERE tenant_id = $1 AND id = $2 AND status = 'held' RETURNING ${ENTRY_RETURNING}`, [a.tenantId, a.id, a.actorId, a.at])).rows[0];
}
"

