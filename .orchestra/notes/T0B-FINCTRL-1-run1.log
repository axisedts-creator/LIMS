    WHERE e.tenant_id = $1 AND e.party_kind = $2 AND e.party_id = $3 AND e.entry_date BETWEEN $4::date AND $5::date AND e.status <> 'held'
    ORDER BY e.entry_date, e.receipt_seq LIMIT $6`, [p.tenantId, p.partyKind, p.partyId, p.from, p.to, p.limit])).rows;
