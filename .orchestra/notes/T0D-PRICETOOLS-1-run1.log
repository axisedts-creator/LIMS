"'use client';
// SCR-07 analyte editor (04-UI-UX §4): create (initial draft version) or view/edit versions of an analyte.
// Display fields + clinical definition; published versions are read-only (edit = new draft, AC-03.2); publish goes through PublishDialog.
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { Button } from '@lims/ui/components/Button';
import { Form } from '@lims/ui/components/Form';
import { IntegerField } from '@lims/ui/components/IntegerField';
import { Select } from '@lims/ui/components/Select';
import { TextField } from '@lims/ui/components/TextField';
import { useToast } from '@lims/ui/components/Toast';
import { createAnalyteAction, createAnalyteVersionDraftAction, updateAnalyteVersionDraftAction } from '../server/actions';
import type { AnalyteRow, AnalyteVersion } from '../server/types';
import { FormulaPanel } from './FormulaPanel';
import { PublishDialog } from './PublishDialog';
import { errAt, fmtDateTime, FailBanner, MirrorInvalid, newKey, PERM, STATUS_LABEL, type Fail } from './shared';

const CODE_RE = /^[A-Z][A-Z0-9_]{0,31}$/;
const CODE_HINT = '^[A-Z][A-Z0-9_]{0,31}$';
const RESULT_TYPES = [
  { value: 'numeric', label: 'Numeric' },
  { value: 'ordinal', label: 'Ordinal' },
  { value: 'coded', label: 'Coded' },
  { value: 'text', label: 'Text' },
  { value: 'narrative', label: 'Narrative' },
] as const;
const NEEDS_VALUE_SET = new Set(['ordinal', 'coded']);
type Draft = { id: string; version_no: number; version: number };

export function AnalyteEditor({ testId, analyte, versions, units, methods, valueSets, subheadings, rangeDraft, criticalDraft, permissions }: {
  testId: string;
  analyte: AnalyteRow | null;
  versions: readonly AnalyteVersion[];
  units: readonly { code: string; display: string }[];
  methods: readonly { id: string; name: string; is_active: boolean }[];
  valueSets: readonly { code: string; display: string; is_ordered: boolean }[];
  subheadings: readonly string[];
  rangeDraft?: Draft | undefined;
  criticalDraft?: Draft | undefined;
  permissions: readonly string[];
}) {
  const router = useRouter();
  const toast = useToast();
  const canManage = permissions.includes(PERM.manage);
  const isCreate = analyte === null;

  const draft = versions.find((v) => v.status === 'draft');
  const published = versions.find((v) => v.status === 'published');
  const [selected, setSelected] = useState(() => String((published ?? versions[0])?.version_no ?? ''));
  const [editing, setEditing] = useState(false);
  const shown = versions.find((v) => String(v.version_no) === selected);
  const canEdit = canManage && (isCreate || (editing && shown?.status === 'draft'));

  // display fields (create only; existing analytes edit them via the Analytes tab)
  const [code, setCode] = useState(analyte?.code ?? '');
  const [name, setName] = useState(analyte?.name ?? '');
  const [printName, setPrintName] = useState(analyte?.print_name ?? '');
  const [subheading, setSubheading] = useState(analyte?.report_subheading ?? '');
  // clinical definition (per version)
  const [resultType, setResultType] = useState(shown?.result_type ?? 'numeric');
  const [unit, setUnit] = useState(shown?.unit_code ?? '');
  const [decimals, setDecimals] = useState<number | undefined>(shown?.decimals);
  const [method, setMethod] = useState(shown?.method_id ?? '');
  const [valueSet, setValueSet] = useState(shown?.value_set_code ?? '');
  const [formula, setFormula] = useState(shown?.formula_expression ?? '');
  const [fail, setFail] = useState<Fail>();
  const [local, setLocal] = useState<{ code?: string }>({});
  const [publishing, setPublishing] = useState(false);

  const load = (v: AnalyteVersion | undefined) => {
    setResultType(v?.result_type ?? 'numeric');
    setUnit(v?.unit_code ?? '');
    setDecimals(v?.decimals);
    setMethod(v?.method_id ?? '');
    setValueSet(v?.value_set_code ?? '');
    setFormula(v?.formula_expression ?? '');
    setFail(undefined);
  };
  const choose = (no: string) => {
    setSelected(no);
    setEditing(false);
    load(versions.find((v) => String(v.version_no) === no));
  };

  const numeric = resultType === 'numeric';
  const needsSet = NEEDS_VALUE_SET.has(resultType);
  const off = !canEdit;

  /** Clinical fields for the API; only what applies to the chosen result type. */
  const definition = () => ({
    result_type: resultType,
    ...(numeric && unit ? { unit_code: unit } : {}),
    ...(numeric && decimals !== undefined ? { decimals } : {}),
    ...(method && resultType !== 'narrative' ? { method_id: method } : {}),
    ...(needsSet && valueSet ? { value_set_code: valueSet } : {}),
    ...(numeric && formula.trim() ? { formula_expression: formula } : {}),
  });

  const submit = async () => {
    if (isCreate) {
      if (!CODE_RE.test(code)) return setLocal({ code: `Code must match ${CODE_HINT}` });
      setLocal({});
      const r = await createAnalyteAction(testId, { code, name, ...(printName ? { print_name: printName } : {}), ...(subheading ? { report_subheading: subheading } : {}), initial_version: definition() }, newKey());
      if (r.ok) {
        setFail(undefined);
        toast.show({ tone: 'success', title: `Analyte ${r.data.code} created.` });
        router.push(`/catalog/tests/${testId}?analyte=${r.data.id}`);
      } else setFail(r);
      return;
    }
    if (!shown || shown.status !== 'draft') return;
    const def = definition();
    const was: Record<string, unknown> = { unit_code: shown.unit_code, decimals: shown.decimals, method_id: shown.method_id, value_set_code: shown.value_set_code, formula_expression: shown.formula_expression };
    const unset = Object.keys(was).filter((k) => was[k] !== undefined && !(k in def));
    const r = await updateAnalyteVersionDraftAction(shown.id, shown.version, { ...def, ...(unset.length ? { unset } : {}) });
    if (r.ok) {
      setFail(undefined);
      toast.show({ tone: 'success', title: 'Draft saved.' });
      router.refresh();
    } else setFail(r);
  };

  const createVersion = async () => {
    if (!analyte) return;
    const r = await createAnalyteVersionDraftAction(analyte.id, newKey());
    if (r.ok) {
      setFail(undefined);
      toast.show({ tone: 'success', title: `Draft version ${r.data.version_no} created.` });
      router.refresh();
    } else setFail(r);
  };

  const codeError = local.code ?? errAt(fail, '/code') ?? (fail?.code === 'catalog.code_duplicate' ? 'This code is already used in this test.' : undefined);
  const field = (...p: string[]) => { const m = errAt(fail, ...p); return m ? { error: m } : {}; };
  const unitOrMethodChanged = !!draft && !!published && (draft.unit_code !== published.unit_code || draft.method_id !== published.method_id);
  const hasDraft = !!draft || !!analyte?.has_draft;

  return (
    <div className=\"lims-stack catalog-gap-3\">
      {!isCreate && shown ? (
        <>
          <p>{`Version ${shown.version_no} · ${STATUS_LABEL[shown.status] ?? shown.status}${shown.effective_from ? ` · effective ${fmtDateTime(shown.effective_from)}` : ''}`}</p>
          <Select label=\"Version\" name=\"version\" value={selected} onChange={choose} options={versions.map((v) => ({ value: String(v.version_no), label: `Version ${v.version_no} · ${STATUS_LABEL[v.status] ?? v.status}` }))} />
        </>
      ) : null}
      {fail && !(fail.status === 400 && fail.errors?.length) ? (
        <FailBanner
          fail={fail}
          extra={fail.code === 'catalog.version_in_use' && canManage ? <div><Button onPress={() => void createVersion()}>Create new version</Button></div> : undefined}
        />
      ) : null}
      <Form onSubmit={submit} errorSummary={false}>
        <MirrorInvalid>
        {isCreate ? (
          <>
            <TextField label=\"Code\" name=\"code\" maxLength={32} isRequired value={code} description={CODE_HINT} onChange={(v) => { setCode(v.toUpperCase()); setLocal({}); }} {...(codeError ? { error: codeError } : {})} />
            <TextField label=\"Name\" name=\"name\" maxLength={120} isRequired value={name} onChange={setName} {...field('/name')} />
            <TextField label=\"Print name\" name=\"print_name\" maxLength={120} value={printName} onChange={setPrintName} {...field('/print_name')} />
            <TextField label=\"Sub-heading\" name=\"report_subheading\" maxLength={80} value={subheading} onChange={setSubheading} {...(subheadings.length ? { description: `Existing: ${subheadings.join(', ')}` } : {})} {...field('/report_subheading')} />
          </>
        ) : null}
        <Select label=\"Result type\" name=\"result_type\" isDisabled={off} value={resultType as (typeof RESULT_TYPES)[number]['value']} onChange={setResultType} options={RESULT_TYPES} {...field('/initial_version/result_type', '/result_type')} />
        {numeric ? (
          <>
            <Select label=\"Unit\" name=\"unit_code\" isDisabled={off} {...(unit ? { value: unit } : {})} onChange={setUnit} options={units.map((u) => ({ value: u.code, label: u.display }))} {...field('/initial_version/unit_code', '/unit_code')} />
            <IntegerField label=\"Decimals\" name=\"decimals\" min={0} max={6} isRequired isDisabled={off} {...(decimals !== undefined ? { value: decimals } : {})} onChange={setDecimals} {...field('/initial_version/decimals', '/decimals')} />
          </>
        ) : null}
        {resultType !== 'narrative' ? (
          <Select label=\"Method\" name=\"method_id\" isDisabled={off} {...(method ? { value: method } : {})} onChange={setMethod} options={methods.filter((m) => m.is_active || m.id === method).map((m) => ({ value: m.id, label: m.name }))} {...field('/initial_version/method_id', '/method_id')} />
        ) : null}
        {needsSet ? (
          <Select label=\"Value set\" name=\"value_set_code\" isRequired isDisabled={off} {...(valueSet ? { value: valueSet } : {})} onChange={setValueSet} options={valueSets.map((s) => ({ value: s.code, label: s.display }))} {...field('/initial_version/value_set_code', '/value_set_code')} />
        ) : null}
        {numeric ? (
          <FormulaPanel analyteId={analyte?.id} value={formula} onChange={setFormula} isReadOnly={off} error={errAt(fail, '/initial_version/formula_expression', '/formula_expression')} />
        ) : null}
        </MirrorInvalid>
        <div className=\"lims-inline catalog-gap-2\">
          {canEdit ? <Button type=\"submit\" variant=\"primary\" shortcut=\"Ctrl+Enter\">Save</Button> : null}
          {canEdit && !isCreate ? <Button variant=\"ghost\" onPress={() => choose(selected)}>Cancel</Button> : null}
        </div>
      </Form>
      {!isCreate && canManage ? (
        <div className=\"lims-inline catalog-gap-2\">
          {!hasDraft ? <Button onPress={() => void createVersion()}>Create new version</Button> : null}
          {hasDraft && !editing && draft ? <Button onPress={() => { setSelected(String(draft.version_no)); setEditing(true); load(draft); }}>Edit draft</Button> : null}
          {editing && shown?.status === 'draft' ? <Button variant=\"primary\" onPress={() => setPublishing(true)}>Publish…</Button> : null}
        </div>
      ) : null}
      {!isCreate && editing && shown?.status === 'draft' && analyte ? (
        <PublishDialog
          analyte={{ id: analyte.id, code: analyte.code, name: analyte.name }}
          version={{ id: shown.id, version_no: shown.version_no, version: shown.version }}
          rangeDraft={rangeDraft}
          criticalDraft={criticalDraft}
          unitOrMethodChanged={unitOrMethodChanged}
          permissions={permissions}
          isOpen={publishing}
          onClose={() => setPublishing(false)}
        />
      ) : null}
    </div>
  );
}

'use client';
// SCR-06 Analytes tab (04-UI-UX §4): table in sort_order, row open → ?analyte=<id>, Alt+↑/↓ reorders via PATCH sort_order (#31).
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { Badge } from '@lims/ui/components/Badge';
import { Button } from '@lims/ui/components/Button';
import { useToast } from '@lims/ui/components/Toast';
import { VisuallyHidden } from '@lims/ui/components/VisuallyHidden';
import { updateAnalyteAction } from '../server/actions';
import type { AnalyteRow } from '../server/types';
import { FailBanner, PERM, type Fail } from './shared';

const COLUMNS = ['Order', 'Sub-heading', 'Code', 'Name', 'Result type', 'Unit', 'Decimals', 'Method', 'Formula', 'Range set', 'Current version', 'Draft'] as const;
const RESULT_LABEL: Record<string, string> = { numeric: 'Numeric', ordinal: 'Ordinal', coded: 'Coded', text: 'Text', narrative: 'Narrative', attachment: 'Attachment' };
const HAS_RANGES = new Set(['numeric', 'ordinal', 'coded']);

export function AnalytesTab({ testId, analytes, permissions }: { testId: string; analytes: readonly AnalyteRow[]; permissions: readonly string[] }) {
  const router = useRouter();
  const toast = useToast();
  const [fail, setFail] = useState<Fail>();
  const canManage = permissions.includes(PERM.manage);
  const rows = [...analytes].sort((a, b) => a.sort_order - b.sort_order);
  const base = `/catalog/tests/${testId}`;

  // ponytail: sort_order is set between the new neighbours (midpoint), ties possible when the gap is 0 — renumber server-side if that bites.
  const move = async (i: number, dir: 1 | -1) => {
    const row = rows[i]!;
    const over = rows[i + dir];
    if (!canManage || !over) return;
    const beyond = rows[i + 2 * dir];
    const target = beyond ? Math.floor((over.sort_order + beyond.sort_order) / 2) : over.sort_order + dir * 10;
    const sort_order = Math.min(9999, Math.max(0, target === over.sort_order ? over.sort_order + dir : target));
    const r = await updateAnalyteAction(row.id, row.version, { sort_order });
    if (r.ok) {
      setFail(undefined);
      toast.show({ tone: 'success', title: 'Order saved.' });
      router.refresh();
    } else setFail(r);
  };

  if (rows.length === 0) {
    return (
      <div className=\"lims-stack catalog-gap-3\">
<p>This test has no analytes yet.</p>
        {canManage ? <div><Button variant=\"primary\" onPress={() => router.push(`${base}?analyte=new`)}>Add analyte</Button></div> : null}
      </div>
    );
  }

  return (
    <div className=\"lims-stack catalog-gap-3\">
      {fail ? <FailBanner fail={fail} /> : null}
      {canManage ? <div><Button variant=\"primary\" onPress={() => router.push(`${base}?analyte=new`)}>Add analyte</Button></div> : null}
      <table className=\"lims-table\" aria-label=\"Analytes\">
        <thead>
          <tr>
            {COLUMNS.map((c) => <th key={c} scope=\"col\">{c}</th>)}
            <th scope=\"col\"><VisuallyHidden>Actions</VisuallyHidden></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((a, i) => (
            <tr
              key={a.id}
              tabIndex={0}
              aria-keyshortcuts={canManage ? 'Alt+ArrowUp Alt+ArrowDown' : undefined}
              onKeyDown={(e) => {
                if (e.target !== e.currentTarget) return;
                if (e.altKey && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
                  e.preventDefault();
                  void move(i, e.key === 'ArrowDown' ? 1 : -1);
                } else if (e.key === 'Enter') router.push(`${base}?analyte=${a.id}`);
              }}
            >
              <td>{a.sort_order}</td>
              <td>{a.report_subheading ?? ''}</td>
              <td>{a.code}</td>
              <td>{a.name}</td>
              <td>{RESULT_LABEL[a.result_type] ?? a.result_type}</td>
              <td>{a.unit_code ?? ''}</td>
              <td>{a.decimals ?? ''}</td>
              <td>{a.method_name ?? ''}</td>
              <td>
                {a.formula_expression ? (
                  <>
                    <span role=\"img\" aria-label=\"Formula\">ƒ</span> <code>{a.formula_expression}</code>
                  </>
                ) : null}
              </td>
              <td>
                {a.range_set_version != null ? `v${a.range_set_version}` : HAS_RANGES.has(a.result_type) ? <Badge tone=\"warning\">None</Badge> : '—'}
              </td>
              <td>{a.current_version_no != null ? `v${a.current_version_no}` : ''}</td>
              <td>{a.has_draft ? <Badge tone=\"info\">Draft</Badge> : null}</td>
              <td><Button size=\"sm\" onPress={() => router.push(`${base}?analyte=${a.id}`)}>Open</Button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

// 403 from a catalog read (03-APP-FLOW §5): full-page message with a way back; no table.
export function CatalogForbidden() {
  return (
    <section className=\"lims-state\" aria-labelledby=\"catalog-forbidden\">
      <h1 id=\"catalog-forbidden\" className=\"lims-state-title\">You don&apos;t have access to this part of the catalog</h1>
      <p className=\"lims-state-body\">
        <a className=\"lims-link\" href=\"/\">Back to home</a>
      </p>
    </section>
  );
}

'use client';
// SCR-01 Catalog home (04-UI-UX §4; 03-APP-FLOW §5). health === null = the load failed: tiles show \"—\", Reference + Retry.
import { useRouter } from 'next/navigation';
import { Button } from '@lims/ui/components/Button';
import { EmptyState } from '@lims/ui/components/EmptyState';
import { ErrorState } from '@lims/ui/components/ErrorState';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { StatTile } from '@lims/ui/components/StatTile';
import type { CatalogCounts, CatalogHealthReport } from '../server/types';
import { t } from '@/core/i18n/messages';

const has = (p: readonly string[], x: string) => p.includes(x);
const n = (v: number | undefined) => (v === undefined ? '—' : String(v));

// [CONV] filter params of the target lists (SCR-06 / SCR-13 define the filters).
const ATTENTION: { key: keyof CatalogHealthReport; label: string; href: string }[] = [
  { key: 'active_orderables_without_default_price', label: 'Active orderables without a default price', href: '/catalog/tests?health=without_default_price' },
  { key: 'analytes_without_reference_range', label: 'Analytes without a reference range', href: '/catalog/tests?health=without_reference_range' },
  { key: 'tests_without_specimen_type', label: 'Tests without a specimen type', href: '/catalog/tests?health=without_specimen_type' },
  { key: 'tests_missing_required_analyte', label: 'Tests missing their narrative/attachment analyte', href: '/catalog/tests?health=missing_required_analyte' },
  { key: 'unmapped_formula_inputs', label: 'Formulas referring to inactive analytes', href: '/catalog/tests?health=unmapped_formula_inputs' },
];

export function CatalogHome({ health, counts, revision, permissions, requestId }: {
  health: CatalogHealthReport | null;
  counts: CatalogCounts | null;
  revision: number | null;
  permissions: readonly string[];
  requestId?: string;
}) {
  const router = useRouter();
  const go = (href: string, label: string, primary = false) => (
    <Button key={href} variant={primary ? 'primary' : 'secondary'} onPress={() => router.push(href)}>
      {label}
    </Button>
  );
  const tests = has(permissions, 'catalog.test.read');
  const manage = has(permissions, 'catalog.test.manage');
  const canImport = manage || has(permissions, 'catalog.price_list.manage'); // kind-dependent import permissions (TRD §5.2 #97)
  const failed = health === null;
  const c = failed ? null : counts;
  const empty = !!c && c.departments === 0 && c.tests === 0;

  return (
    <section aria-label=\"Catalog\">
      <PageHeader
        title={t('catalog.nav.home')}
        helpKey=\"catalog.home\"
        actions={
          <>
            {canImport ? go('/catalog/imports', 'Import from Excel') : null}
            {manage ? go('/catalog/tests?new=1', 'New test', true) : null}
          </>
        }
      />
      <div className=\"lims-stat-row\">
        {tests ? <StatTile label=\"Tests (active)\" value={n(c?.tests)} /> : null}
        {tests ? <StatTile label=\"Panels & packages\" value={n(c?.panels)} /> : null}
        {has(permissions, 'catalog.referrer.read') ? <StatTile label=\"Doctors\" value={c ? `${n(c.doctors)} (${n(c.doctors_unverified)} unverified)` : '—'} /> : null}
        {has(permissions, 'catalog.price_list.read') ? <StatTile label=\"Price lists\" value={n(c?.price_lists)} /> : null}
        <StatTile label=\"Catalog revision\" value={failed || revision === null ? '—' : String(revision)} />
      </div>
      {failed ? (
        <>
          <ErrorState title=\"The catalog summary could not be loaded.\" {...(requestId ? { requestId } : {})} onRetry={() => router.refresh()} />
          {tests ? (
            <section aria-labelledby=\"catalog-attention\">
              <h2 id=\"catalog-attention\">Needs attention</h2>
              <ul>
                {ATTENTION.map((a) => (
                  <li key={a.key}>
                    {a.label} <span>—</span>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
        </>
      ) : empty ? (
        <>
          <EmptyState title=\"No catalog yet. Import the starter workbook or create your first department.\" />
          <p>
            {canImport ? go('/catalog/imports', 'Import from Excel') : null}
            {manage ? go('/catalog/departments?new=1', 'New department', true) : null}
          </p>
        </>
      ) : tests ? (
        <section aria-labelledby=\"catalog-attention\">
          <h2 id=\"catalog-attention\">Needs attention</h2>
          {health.truncated ? <p role=\"note\">Each check lists at most the first 200 items; there are more.</p> : null}
          <ul>
            {ATTENTION.map((a) => (
              <li key={a.key}>
                <a className=\"lims-link\" href={a.href}>{`${a.label} (${(health[a.key] as readonly string[]).length})`}</a>
              </li>
            ))}
            <li>{`Tax default configured: ${health.tax_default_configured ? 'Yes' : 'No'}`}</li>
          </ul>
        </section>
      ) : null}
    </section>
  );
}

'use client';
// SCR-10 Comment codes (04-UI-UX §4): code, department (blank = all departments), text. Search is a code prefix, Department filter
// includes tenant-wide codes; both run over the loaded rows [CONV]. The code (and department) are create-only.
import { useRef, useState } from 'react';
import { Button } from '@lims/ui/components/Button';
import { CodeField } from '@lims/ui/components/CodeField';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { Select } from '@lims/ui/components/Select';
import { Switch } from '@lims/ui/components/Switch';
import { TextArea } from '@lims/ui/components/TextArea';
import { TextField } from '@lims/ui/components/TextField';
import { Checkbox } from '@lims/ui/components/Checkbox';
import { updateCommentCodeAction } from '../server/catalogActions';
import { createCommentCodeFullAction } from '../server/testMgmtActions';
import { errAt, type Fail } from './shared';
import { COMMENT_CODE_RE, type CommentCode, type Department } from '../server/types';
import { DUPLICATE, EditorDialog, MasterTable, StatusBadge, canManage, changed, useListShortcuts, type Col } from './master-ui';
import { t } from '@/core/i18n/messages';

const ALL = 'all';
const HELP = 'Technologists type :CODE followed by a space in the result comment to insert this text. Changing the text later does not change results already saved.';
const preview = (t: string) => (t.length > 80 ? `${t.slice(0, 80)}…` : t);

export function CommentCodesScreen({ commentCodes, departments, permissions }: { commentCodes: readonly CommentCode[]; departments: readonly Department[]; permissions: readonly string[] }) {
  const manage = canManage(permissions);
  const [editing, setEditing] = useState<CommentCode | 'new' | null>(null);
  const [q, setQ] = useState('');
  const [dept, setDept] = useState<string>(ALL);
  const search = useRef<HTMLDivElement>(null);
  const openNew = manage ? () => setEditing('new') : undefined;
  useListShortcuts(search, openNew);
  const deptName = new Map(departments.map((d) => [d.id, d.name]));
  const needle = q.trim().toLowerCase();
  const rows = commentCodes.filter((c) => (dept === ALL || !c.department_id || c.department_id === dept) && (!needle || c.code.toLowerCase().startsWith(needle)));
  const cols: Col<CommentCode>[] = [
    { header: 'Code', cell: (r) => r.code },
    { header: 'Department', cell: (r) => (r.department_id ? (deptName.get(r.department_id) ?? '—') : 'All departments') },
    { header: 'Text', cell: (r) => preview(r.text) },
    { header: 'Status', cell: (r) => <StatusBadge active={r.is_active} /> },
    { header: 'Version', cell: (r) => String(r.version) },
  ];
  return (
    <section aria-label=\"Comment codes\">
      <PageHeader title={t('catalog.nav.comment_codes')} helpKey=\"catalog.comment_codes\" actions={openNew ? <Button variant=\"primary\" onPress={openNew}>New comment code</Button> : null} />
      <div className=\"lims-filter-bar\">
        <div ref={search}>
          <TextField label=\"Search\" name=\"q\" maxLength={16} description=\"Code prefix\" value={q} onChange={setQ} />
        </div>
        <Select label=\"Department\" name=\"department_filter\" options={[{ value: ALL, label: 'All departments' }, ...departments.map((d) => ({ value: d.id, label: d.name }))]} value={dept} onChange={setDept} />
      </div>
      <MasterTable
        caption=\"Comment codes\"
        cols={cols}
        rows={rows}
        empty=\"No comment codes for this department.\"
        emptyAction={openNew ? { label: 'Add a comment code', onPress: openNew } : undefined}
        codeOf={(r) => r.code}
        onEdit={manage ? setEditing : undefined}
      />
      {editing ? <CommentCodeDialog item={editing === 'new' ? undefined : editing} departments={departments} onClose={() => setEditing(null)} /> : null}
    </section>
  );
}

// T0D-TESTMGMT-1 (LD-318, ElabAssist Notes): Type (result type the note is offered for), Default template and text format on create.
// [CONV] the format control is labelled \"Format\" (not \"Text format\") so the Text box stays the only field whose label starts with \"Text\".
const NOTE_TYPES = [['numeric', 'Numeric'], ['text', 'Text'], ['ordinal', 'Ordinal'], ['coded', 'List'], ['narrative', 'Narrative'], ['attachment', 'Image'], ['boolean', 'Boolean'], ['test_footer', 'Test footer'], ['space', 'Space'], ['graph', 'Graph'], ['html_descriptive', 'HTML descriptive']]
  .map(([value, label]) => ({ value: value!, label: label! }));

function CommentCodeDialog({ item, departments, onClose }: { item: CommentCode | undefined; departments: readonly Department[]; onClose: () => void }) {
  const [code, setCode] = useState(item?.code ?? '');
  const [dept, setDept] = useState<string>(item?.department_id ?? ALL);
  const [text, setText] = useState(item?.text ?? '');
  const [active, setActive] = useState(item?.is_active ?? true);
  const [codeError, setCodeError] = useState<string>();
  const [noteType, setNoteType] = useState<string>(ALL);
  const [isDefault, setIsDefault] = useState(false);
  const [format, setFormat] = useState<string>('plain');
  const [fail, setFail] = useState<Fail>();
  const create = async (key: string) => {
    const r = await createCommentCodeFullAction({
      code, ...(dept !== ALL ? { department_id: dept } : {}), text, ...(noteType !== ALL ? { result_type: noteType } : {}), ...(isDefault ? { is_default_template: true } : {}), ...(format !== 'plain' ? { text_format: format } : {}),
    }, key);
    setFail(r.ok ? undefined : r);
    return r;
  };
  return (
    <EditorDialog
      title={item ? 'Edit comment code' : 'New comment code'}
      savedText=\"Comment code saved.\"
      reloadLabel=\"Refresh\"
      onClose={onClose}
      onDuplicate={() => setCodeError(DUPLICATE)}
      save={(key) =>
        item
          ? updateCommentCodeAction(item.id, item.version, changed(item, { text, is_active: active }))
          : create(key)
      }
    >
      <CodeField label=\"Code\" name=\"code\" maxLength={16} pattern={COMMENT_CODE_RE.source} patternHint=\"Capital letters A-Z, digits and _, up to 16.\" isRequired isReadOnly={!!item} value={code} onChange={(v) => { setCode(v); setCodeError(undefined); }} {...(codeError ? { error: codeError } : {})} />
      <Select label=\"Department\" name=\"department_id\" isReadOnly={!!item} options={[{ value: ALL, label: 'All departments' }, ...departments.map((d) => ({ value: d.id, label: d.name }))]} value={dept} onChange={setDept} />
      <TextArea label=\"Text\" name=\"text\" maxLength={2000} rows={5} isRequired description={HELP} value={text} onChange={(v) => { setText(v); setFail(undefined); }} {...(errAt(fail, '/text') ? { error: errAt(fail, '/text')! } : {})} />
      {item ? <Switch label=\"Active\" isSelected={active} onChange={setActive} /> : (
        <>
          <Select label=\"Type\" name=\"result_type\" options={[{ value: ALL, label: 'Any result type' }, ...NOTE_TYPES]} value={noteType} onChange={setNoteType} />
          <Checkbox label=\"Default template\" name=\"is_default_template\" isSelected={isDefault} onChange={setIsDefault} />
          <Select label=\"Format\" name=\"text_format\" options={[{ value: 'plain', label: 'Plain text' }, { value: 'markdown', label: 'Markdown (safe subset)' }]} value={format} onChange={setFormat} />
        </>
      )}
    </EditorDialog>
  );
}

'use client';
// T0D-TESTMGMT-1 (LD-318, T0D-DENSITY-1): small building blocks for the dense test management forms.
// [CONV] MiniSelect / Check are plain DOM on purpose: the kit Select and Checkbox add react-aria's visually-hidden native controls
// (inline style + a second <select> per field), which the one-screen form budget and the \"no inner scroller\" rule count against.
// MiniSelect is the APG select-only combobox: a button with role=combobox named by its label only (the value is its content), a listbox popup.
import { useId, useRef, useState, type KeyboardEvent, type ReactNode } from 'react';
import { Button } from '@lims/ui/components/Button';
import './catalog.css';

export interface Opt { value: string; label: string }

export function MiniSelect({ label, value, options, onChange, isRequired, isDisabled, error, placeholder = 'Choose…' }: {
  label: string;
  value: string;
  options: readonly Opt[];
  onChange: (v: string) => void;
  isRequired?: boolean | undefined;
  isDisabled?: boolean | undefined;
  error?: string | undefined;
  placeholder?: string;
}) {
  const id = useId();
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState(0);
  const button = useRef<HTMLButtonElement>(null);
  const current = options.find((o) => o.value === value);
  const show = () => { setActive(Math.max(0, options.findIndex((o) => o.value === value))); setOpen(true); };
  const pick = (o: Opt | undefined) => { if (o) onChange(o.value); setOpen(false); button.current?.focus(); };
  const onKey = (e: KeyboardEvent) => {
    const k = e.key;
    if (!open) {
      if (k === 'ArrowDown' || k === 'ArrowUp' || k === 'Enter' || k === ' ') { e.preventDefault(); show(); }
      return;
    }
    if (k === 'ArrowDown') setActive((a) => Math.min(options.length - 1, a + 1));
    else if (k === 'ArrowUp') setActive((a) => Math.max(0, a - 1));
    else if (k === 'Home') setActive(0);
    else if (k === 'End') setActive(options.length - 1);
    else if (k === 'Enter' || k === ' ') pick(options[active]);
    else if (k === 'Escape') setOpen(false);
    else if (k === 'Tab') { setOpen(false); return; }
    else return;
    e.preventDefault();
  };
  return (
    <div className=\"lims-field catalog-mini-select\" onBlur={(e) => { if (!e.currentTarget.contains(e.relatedTarget as Node | null)) setOpen(false); }}>
      <span id={`${id}-l`} className=\"lims-label\">{label}{isRequired ? <span aria-hidden=\"true\"> *</span> : null}</span>
      <button
        ref={button}
        type=\"button\"
        role=\"combobox\"
        className=\"lims-input lims-select-trigger\"
        aria-labelledby={`${id}-l`}
        aria-haspopup=\"listbox\"
        aria-expanded={open}
        {...(open ? { 'aria-controls': `${id}-lb`, 'aria-activedescendant': `${id}-o${active}` } : {})}
        {...(isRequired ? { 'aria-required': true } : {})}
        {...(error ? { 'aria-invalid': true, 'aria-describedby': `${id}-e` } : {})}
        disabled={isDisabled}
        onClick={() => (open ? setOpen(false) : show())}
        onKeyDown={onKey}
      >
        {current?.label ?? placeholder}
      </button>
      {open ? (
        <ul id={`${id}-lb`} role=\"listbox\" aria-labelledby={`${id}-l`} className=\"lims-listbox catalog-mini-listbox\">
          {options.map((o, i) => (
            <li
              key={o.value}
              id={`${id}-o${i}`}
              role=\"option\"
              aria-selected={o.value === value}
              className={`lims-option${i === active ? ' catalog-option-active' : ''}`}
              onMouseDown={(e) => e.preventDefault()}
              onClick={() => pick(o)}
            >
              {o.label}
            </li>
          ))}
        </ul>
      ) : null}
      {error ? <span id={`${id}-e`} className=\"lims-error\">{error}</span> : null}
    </div>
  );
}

/** Native checkbox with its label (light; no hidden duplicate control). */
export function Check({ label, checked, onChange, isDisabled }: { label: string; checked: boolean; onChange: (v: boolean) => void; isDisabled?: boolean | undefined }) {
  return (
    <label className=\"catalog-check\">
      <input type=\"checkbox\" checked={checked} disabled={isDisabled} onChange={(e) => onChange(e.target.checked)} />
      {label}
    </label>
  );
}

/** One form section: heading + a grid of `columns` equal columns (data-columns drives the CSS and the one-screen budget). */
export function GridSection({ title, columns, note, children }: { title: string; columns: 3 | 4 | 5 | 6; note?: string; children: ReactNode }) {
  const id = useId();
  return (
    <section className=\"catalog-grid-section\" aria-labelledby={id} data-columns={columns}>
      <h2 id={id} className=\"catalog-grid-title\">{title}</h2>
      {note ? <p className=\"lims-description\">{note}</p> : null}
      <div className=\"catalog-grid\" data-columns={columns}>{children}</div>
    </section>
  );
}

export interface PreviewRow { name: string; value: string; unit: string; range: string }

/** Report preview built from SAMPLE data only (never a real patient): patient header block + Test Name · Value · Unit · Reference Range. */
export function ReportPreview({ title, rows }: { title?: string | undefined; rows: readonly PreviewRow[] }) {
  const id = useId();
  return (
    <section className=\"catalog-preview\" aria-labelledby={id}>
      <h2 id={id} className=\"catalog-grid-title\">Report preview</h2>
      <dl className=\"catalog-preview-header\">
        <div><dt>Patient</dt><dd>SAMPLE PATIENT (synthetic)</dd></div>
        <div><dt>Age / Sex</dt><dd>35 Y / Female</dd></div>
        <div><dt>Sample</dt><dd>SAMPLE-0001</dd></div>
        <div><dt>Date</dt><dd>01/01/2026</dd></div>
      </dl>
      <table className=\"lims-table lims-table-compact\">
        <thead>
          <tr>{['Test Name', 'Value', 'Unit', 'Reference Range'].map((h) => <th key={h} scope=\"col\">{h}</th>)}</tr>
        </thead>
        <tbody>
          {title ? <tr><td colSpan={4}><strong>{title}</strong></td></tr> : null}
          {rows.map((r, i) => (
            <tr key={i}><td>{r.name}</td><td>{r.value}</td><td>{r.unit}</td><td>{r.range}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  );
}

/** Whole number in [min, max] from a text box; '' = not given (undefined); NaN = invalid. */
export function intOf(text: string, min: number, max: number): number | undefined {
  const t = text.trim();
  if (!t) return undefined;
  if (!/^-?\\d{1,9}$/.test(t)) return NaN;
  const n = Number(t);
  return n < min || n > max ? NaN : n;
}

// T0D-TESTMGMT-1 item (6), LD-318 (ElabAssist Test Profile): two list picker for panel / package members. Listboxes \"Available tests\" and
// \"Selected tests\"; Add, Add all, Remove, Remove all; click picks an option, Enter (or double click) on an option moves it. Order = selected order.
export interface PickItem { id: string; label: string }

function ListBox({ label, items, picked, onPick, onMove }: { label: string; items: readonly PickItem[]; picked: string | undefined; onPick: (id: string) => void; onMove: (id: string) => void }) {
  return (
    <div className=\"lims-stack catalog-gap-1\">
      <h3 className=\"catalog-grid-title\">{label}</h3>
      {items.length === 0 ? <p className=\"lims-description\">None</p> : null}
      <ul role=\"listbox\" aria-label={label} className=\"catalog-plain-list catalog-pick-list\">
        {items.map((it) => (
          <li
            key={it.id}
            role=\"option\"
            tabIndex={0}
            aria-selected={it.id === picked}
            className={it.id === picked ? 'catalog-row-chosen' : undefined}
            onClick={() => onPick(it.id)}
            onDoubleClick={() => onMove(it.id)}
            onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); onMove(it.id); } else if (e.key === ' ') { e.preventDefault(); onPick(it.id); } }}
          >
            {it.label}
          </li>
        ))}
      </ul>
    </div>
  );
}

export function TwoListPicker({ available, selected, onChange, isDisabled }: {
  available: readonly PickItem[];
  selected: readonly PickItem[];
  onChange: (selectedIds: string[]) => void;
  isDisabled: boolean;
}) {
  const [left, setLeft] = useState<string>();
  const [right, setRight] = useState<string>();
  const ids = selected.map((s) => s.id);
  const add = (id: string | undefined) => { if (!isDisabled && id && !ids.includes(id)) { onChange([...ids, id]); setLeft(undefined); } };
  const remove = (id: string | undefined) => { if (!isDisabled && id) { onChange(ids.filter((x) => x !== id)); setRight(undefined); } };
  return (
    <div className=\"catalog-two-list\">
      <ListBox label=\"Available tests\" items={available} picked={left} onPick={setLeft} onMove={add} />
      <div className=\"lims-stack catalog-gap-1\">
        <Button size=\"sm\" isDisabled={isDisabled || !left} onPress={() => add(left)}>Add</Button>
        <Button size=\"sm\" isDisabled={isDisabled || available.length === 0} onPress={() => onChange([...ids, ...available.map((a) => a.id)])}>Add all</Button>
        <Button size=\"sm\" isDisabled={isDisabled || !right} onPress={() => remove(right)}>Remove</Button>
        <Button size=\"sm\" isDisabled={isDisabled || selected.length === 0} onPress={() => onChange([])}>Remove all</Button>
      </div>
      <ListBox label=\"Selected tests\" items={selected} picked={right} onPick={setRight} onMove={remove} />
    </div>
  );
}

'use client';
// SCR-12 Credit parties & affiliations (04-UI-UX §4). PAN, phone, email and billing address are rendered only with
// catalog.price_list.manage (the API omits them otherwise; the list never shows them anyway). No credit limit, credit days or
// balance exists here (AC-12.3): that is Billing.
import { useRef, useState } from 'react';
import { Badge } from '@lims/ui/components/Badge';
import { Button } from '@lims/ui/components/Button';
import { CodeField } from '@lims/ui/components/CodeField';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { Select } from '@lims/ui/components/Select';
import { Switch } from '@lims/ui/components/Switch';
import { TextArea } from '@lims/ui/components/TextArea';
import { TextField } from '@lims/ui/components/TextField';
import { createCreditPartyAction, updateCreditPartyAction } from '../server/catalogActions';
import { PARTY_CODE_RE, emailError, phoneError, type CreditParty, type PartyKind } from '../server/types';
import { DUPLICATE, EditorDialog, MasterTable, StatusBadge, useListFilter, useListShortcuts, type Col } from './master-ui';
import { t } from '@/core/i18n/messages';

const KINDS: readonly { value: PartyKind; label: string }[] = [
  { value: 'hospital', label: 'Hospital' }, { value: 'company', label: 'Company' }, { value: 'clinic', label: 'Clinic' },
  { value: 'partner_lab', label: 'Partner lab' }, { value: 'insurer', label: 'Insurer' }, { value: 'other', label: 'Other' },
];
const kindLabel = (k: PartyKind) => KINDS.find((x) => x.value === k)?.label ?? k;
const canManageParties = (permissions: readonly string[]) => permissions.includes('catalog.price_list.manage');
type Optional = 'pan' | 'contact_phone_e164' | 'contact_email' | 'billing_address';

export function CreditPartiesScreen({ creditParties, permissions }: { creditParties: readonly CreditParty[]; permissions: readonly string[] }) {
  const manage = canManageParties(permissions);
  const [editing, setEditing] = useState<CreditParty | 'new' | null>(null);
  const openNew = manage ? () => setEditing('new') : undefined;
  // T0D-UILIST-3 (LD-353 template 1): the shared search + status filter row, plus Kind.
  const [kind, setKind] = useState<PartyKind | 'all'>('all');
  const kindSelect = <Select<PartyKind | 'all'> label=\"Kind\" name=\"kind\" value={kind} onChange={setKind} options={[{ value: 'all', label: 'All' }, ...KINDS]} />;
  const { shown, toolbar, search } = useListFilter(creditParties, (r) => r.name, kindSelect, (r) => r.party_code);
  const rows = shown.filter((r) => kind === 'all' || r.kind === kind);
  useListShortcuts(search, openNew);
  const cols: Col<CreditParty>[] = [
    { header: 'Code', cell: (r) => r.party_code },
    { header: 'Name', cell: (r) => r.name },
    { header: 'Kind', cell: (r) => kindLabel(r.kind) },
    { header: 'Credit allowed', cell: (r) => (r.allows_credit ? 'Yes' : 'No') },
    { header: 'Price list', cell: (r) => (r.price_list_id ? <a className=\"lims-link\" href={`/catalog/price-lists/${r.price_list_id}`}>Open</a> : '—') },
    { header: 'Status', cell: (r) => <StatusBadge active={r.is_active} /> },
  ];
  return (
    <section aria-label=\"Credit parties\">
      <PageHeader title={t('catalog.nav.credit_parties')} helpKey=\"catalog.credit_parties\" actions={openNew ? <Button variant=\"primary\" onPress={openNew}>New credit party</Button> : null} />
      <p>Credit limits, credit days and monthly statements are managed in Billing.</p>
      {toolbar}
      <MasterTable caption=\"Credit parties\" cols={cols} rows={rows}empty=\"No clients or affiliations yet.\" emptyAction={openNew ? { label: 'New credit party', onPress: openNew } : undefined} codeOf={(r) => r.party_code} onEdit={manage ? setEditing : undefined} />
      {editing ? <PartyDialog item={editing === 'new' ? undefined : editing} onClose={() => setEditing(null)} /> : null}
    </section>
  );
}

function PartyDialog({ item, onClose }: { item: CreditParty | undefined; onClose: () => void }) {
  const [code, setCode] = useState(item?.party_code ?? '');
  const [name, setName] = useState(item?.name ?? '');
  const [kind, setKind] = useState<string>(item?.kind ?? '');
  const [credit, setCredit] = useState(item?.allows_credit ?? true);
  const [pan, setPan] = useState(item?.pan ?? '');
  const [phone, setPhone] = useState(item?.contact_phone_e164 ?? '');
  const [email, setEmail] = useState(item?.contact_email ?? '');
  const [address, setAddress] = useState(item?.billing_address ?? '');
  const [active, setActive] = useState(item?.is_active ?? true);
  const [codeError, setCodeError] = useState<string>();
  const [phoneErr, setPhoneErr] = useState<string>();
  const [emailErr, setEmailErr] = useState<string>();

  const check = () => {
    const p = phoneError(phone.trim());
    const e = emailError(email.trim());
    setPhoneErr(p);
    setEmailErr(e);
    return !p && !e;
  };
  const save = (key: string) => {
    const contact: [Optional, string][] = [['pan', pan], ['contact_phone_e164', phone], ['contact_email', email], ['billing_address', address]];
    if (!item) {
      const body: Record<string, unknown> = { name: name.trim(), kind, allows_credit: credit };
      if (code.trim()) body['party_code'] = code.trim();
      for (const [k, v] of contact) if (v.trim()) body[k] = v.trim();
      return createCreditPartyAction(body, key);
    }
    const body: Record<string, unknown> = {};
    const unset: Optional[] = [];
    if (name.trim() !== item.name) body['name'] = name.trim();
    if (kind !== item.kind) body['kind'] = kind;
    if (credit !== item.allows_credit) body['allows_credit'] = credit;
    if (active !== item.is_active) body['is_active'] = active;
    for (const [k, v] of contact) {
      const after = v.trim();
      if (after === (item[k] ?? '')) continue;
      if (after === '') unset.push(k);
      else body[k] = after;
    }
    if (unset.length) body['unset'] = unset;
    return updateCreditPartyAction(item.id, item.version, body);
  };
  return (
    <EditorDialog title={item ? 'Edit credit party' : 'New credit party'} savedText=\"Credit party saved.\" reloadLabel=\"Refresh\" onClose={onClose} onDuplicate={() => setCodeError(DUPLICATE)} check={check} save={save}>
      <CodeField label=\"Party code\" name=\"party_code\" maxLength={20} pattern={PARTY_CODE_RE.source} patternHint=\"Capital letters, digits, _ and -, up to 20.\" {...(item ? {} : { description: 'Leave blank to assign one automatically.' })} isReadOnly={!!item} value={code} onChange={(v) => { setCode(v); setCodeError(undefined); }} {...(codeError ? { error: codeError } : {})} />
      <TextField label=\"Name\" name=\"name\" maxLength={160} isRequired value={name} onChange={setName} />
      <Select label=\"Kind\" name=\"kind\" isRequired options={KINDS} value={kind} onChange={setKind} />
      <Switch label=\"Credit allowed\" isSelected={credit} onChange={setCredit} />
      <p className=\"lims-description\">Off = affiliation with its own prices; patients still pay at the counter</p>
      <TextField label=\"PAN\" name=\"pan\" maxLength={20} value={pan} onChange={setPan} />
      <TextField label=\"Phone\" name=\"contact_phone_e164\" maxLength={16} inputMode=\"tel\" description=\"International format, for example +97714000000.\" value={phone} onChange={(v) => { setPhone(v); setPhoneErr(undefined); }} {...(phoneErr ? { error: phoneErr } : {})} />
      <TextField label=\"Email\" name=\"contact_email\" maxLength={254} inputMode=\"email\" value={email} onChange={(v) => { setEmail(v); setEmailErr(undefined); }} {...(emailErr ? { error: emailErr } : {})} />
      <TextArea label=\"Billing address\" name=\"billing_address\" maxLength={500} value={address} onChange={setAddress} />
      {item ? <Switch label=\"Active\" isSelected={active} onChange={setActive} /> : null}
    </EditorDialog>
  );
}

'use client';
// SCR-02 Departments (04-UI-UX §4): Code · Name · Report order · Report heading · Status · Updated; New / Edit dialog.
import { useState } from 'react';
import { useSearchParams } from 'next/navigation';
import { Badge } from '@lims/ui/components/Badge';
import { Button } from '@lims/ui/components/Button';
import { CodeField } from '@lims/ui/components/CodeField';
import { DateText } from '@lims/ui/components/DateText';
import { IntegerField } from '@lims/ui/components/IntegerField';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { Switch } from '@lims/ui/components/Switch';
import { TextField } from '@lims/ui/components/TextField';
import { createMasterAction, updateMasterAction } from '../server/actions';
import { CODE_RE, type Department } from '../server/types';
import { CODE_HINT, DUPLICATE, EditorDialog, MasterTable, canManage, changed, statusText, useListFilter, useListShortcuts, type Col } from './master-ui';
import { t } from '@/core/i18n/messages';

export function DepartmentsList({ departments, permissions }: { departments: readonly Department[]; permissions: readonly string[] }) {
  const manage = canManage(permissions);
  const [editing, setEditing] = useState<Department | 'new' | null>(useSearchParams().get('new') === '1' && manage ? 'new' : null);
  const { shown, toolbar, search } = useListFilter(departments, (d) => d.name);
  const openNew = manage ? () => setEditing('new') : undefined;
  useListShortcuts(search, openNew);

  const cols: Col<Department>[] = [
    { header: 'Code', cell: (d) => d.code },
    { header: 'Name', cell: (d) => d.name },
    { header: 'Report order', cell: (d) => String(d.report_order) },
    { header: 'Report heading', cell: (d) => d.report_heading ?? '—' },
    { header: 'Status', cell: (d) => <Badge tone={d.is_active ? 'success' : 'neutral'}>{statusText(d.is_active)}</Badge> },
    { header: 'Updated', cell: (d) => <DateText value={d.updated_at as never} withTime /> },
  ];

  return (
    <section aria-label=\"Departments\">
      <PageHeader title={t('catalog.nav.departments')} helpKey=\"catalog.departments\" actions={openNew ? <Button variant=\"primary\" onPress={openNew}>New department</Button> : null} />
      {toolbar}
      <MasterTable caption=\"Departments\" cols={cols} rows={shown} empty=\"No test categories yet.\" emptyAction={openNew ? { label: 'New department', onPress: openNew } : undefined} onEdit={manage ? setEditing : undefined} />
      {editing ? <DepartmentDialog item={editing === 'new' ? undefined : editing} onClose={() => setEditing(null)} /> : null}
    </section>
  );
}

function DepartmentDialog({ item, onClose }: { item: Department | undefined; onClose: () => void }) {
  const [code, setCode] = useState(item?.code ?? '');
  const [name, setName] = useState(item?.name ?? '');
  const [order, setOrder] = useState<number | undefined>(item?.report_order ?? 100);
  const [heading, setHeading] = useState(item?.report_heading ?? '');
  const [active, setActive] = useState(item?.is_active ?? true);
  const [codeError, setCodeError] = useState<string>();
  const body = { name, report_order: order!, ...(heading.trim() || item?.report_heading ? { report_heading: heading.trim() } : {}), is_active: active };

  return (
    <EditorDialog
      title={item ? 'Edit department' : 'New department'}
      savedText=\"Department saved.\"
      onClose={onClose}
      onDuplicate={() => setCodeError(DUPLICATE)}
      save={(key) => (item ? updateMasterAction('department', item.id, item.version, changed(item, body)) : createMasterAction('department', { code, ...body }, key))}
    >
      <CodeField label=\"Code\" name=\"code\" maxLength={32} pattern={CODE_RE.source} patternHint={CODE_HINT} isRequired isReadOnly={!!item} value={code} onChange={(v) => { setCode(v); setCodeError(undefined); }} {...(codeError ? { error: codeError } : {})} />
      <TextField label=\"Name\" name=\"name\" maxLength={100} isRequired value={name} onChange={setName} />
      <IntegerField label=\"Report order\" name=\"report_order\" min={0} max={9999} isRequired {...(order !== undefined ? { value: order } : {})} onChange={setOrder} />
      <TextField label=\"Report heading\" name=\"report_heading\" maxLength={100} value={heading} onChange={setHeading} />
      <Switch label=\"Active\" isSelected={active} onChange={setActive} />
    </EditorDialog>
  );
}

'use client';
// SCR-11 doctor detail: edit form + Verify + \"Merge into…\". Phone and Email (contact fields) are rendered ONLY with
// catalog.referrer.manage — the API omits them otherwise, and this component drops them even if the object carries them (AC-11.4).
// Without manage, or for a merged-away doctor, the form is read-only text inputs.
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { Badge } from '@lims/ui/components/Badge';
import { Banner } from '@lims/ui/components/Banner';
import { Button } from '@lims/ui/components/Button';
import { CodeField } from '@lims/ui/components/CodeField';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { Select } from '@lims/ui/components/Select';
import { Switch } from '@lims/ui/components/Switch';
import { TextArea } from '@lims/ui/components/TextArea';
import { TextField } from '@lims/ui/components/TextField';
import { useToast } from '@lims/ui/components/Toast';
import { updateDoctorAction, verifyDoctorAction } from '../server/catalogActions';
import { PARTY_CODE_RE, emailError, phoneError, type Doctor, type DoctorSummary } from '../server/types';
import { CONFLICT, SaveForm } from './master-ui';
import { DoctorMergeDialog } from './DoctorMergeDialog';

export const canManageDoctors = (permissions: readonly string[]) => permissions.includes('catalog.referrer.manage');
const COUNCILS = [{ value: 'none', label: 'None' }, { value: 'NMC', label: 'NMC' }, { value: 'Other', label: 'Other' }] as const;
type Optional = 'qualification' | 'registration_council' | 'registration_no' | 'phone_e164' | 'email' | 'notes';

export function DoctorDetail({ doctor, mergeTargets, permissions }: { doctor: Doctor; mergeTargets: readonly DoctorSummary[]; permissions: readonly string[] }) {
  const manage = canManageDoctors(permissions);
  const router = useRouter();
  const toast = useToast();
  const merged = !!doctor.merged_into_id;
  const ro = !manage || merged;
  const [name, setName] = useState(doctor.display_name);
  const [qualification, setQualification] = useState(doctor.qualification ?? '');
  const [council, setCouncil] = useState(doctor.registration_council ?? 'none');
  const [regNo, setRegNo] = useState(doctor.registration_no ?? '');
  const [phone, setPhone] = useState(manage ? (doctor.phone_e164 ?? '') : '');
  const [email, setEmail] = useState(manage ? (doctor.email ?? '') : '');
  const [notes, setNotes] = useState(doctor.notes ?? '');
  const [active, setActive] = useState(doctor.is_active);
  const [phoneErr, setPhoneErr] = useState<string>();
  const [emailErr, setEmailErr] = useState<string>();
  const [merging, setMerging] = useState(false);
  const [verifyBanner, setVerifyBanner] = useState<string>();
  const [verifying, setVerifying] = useState(false);
  const target = merged ? mergeTargets.find((t) => t.id === doctor.merged_into_id) : undefined;

  const check = () => {
    const p = phoneError(phone.trim());
    const e = emailError(email.trim());
    setPhoneErr(p);
    setEmailErr(e);
    return !p && !e;
  };
  /** PATCH carries only what changed; an optional field cleared by the user goes into `unset`. */
  const save = () => {
    const body: Record<string, unknown> = {};
    const unset: Optional[] = [];
    const field = (k: Optional, v: string) => {
      const after = v.trim();
      if (after === (doctor[k] ?? '')) return;
      if (after === '') unset.push(k);
      else body[k] = after;
    };
    if (name.trim() !== doctor.display_name) body['display_name'] = name.trim();
    field('qualification', qualification);
    field('registration_council', council === 'none' ? '' : council);
    field('registration_no', regNo);
    if (manage) {
      field('phone_e164', phone);
      field('email', email);
    }
    field('notes', notes);
    if (active !== doctor.is_active) body['is_active'] = active;
    if (unset.length) body['unset'] = unset;
    return updateDoctorAction(doctor.id, doctor.version, body);
  };

  const verify = async () => {
    if (verifying) return;
    setVerifying(true);
    setVerifyBanner(undefined);
    try {
      const r = await verifyDoctorAction(doctor.id, doctor.version);
      if (r.ok) {
        toast.show({ tone: 'success', title: 'Doctor verified.' });
        router.refresh();
      } else setVerifyBanner(r.code === 'common.version_conflict' ? CONFLICT : 'Could not verify. Try again.');
    } finally {
      setVerifying(false);
    }
  };

  const fields = (
    <>
      <CodeField label=\"Doctor code\" name=\"doctor_code\" maxLength={20} pattern={PARTY_CODE_RE.source} patternHint=\"Set when the doctor was created.\" isReadOnly value={doctor.doctor_code} />
      <TextField label=\"Display name\" name=\"display_name\" maxLength={120} isRequired isReadOnly={ro} value={name} onChange={setName} />
      <TextField label=\"Qualification\" name=\"qualification\" maxLength={120} isReadOnly={ro} value={qualification} onChange={setQualification} />
      {ro ? (
        <TextField label=\"Registration council\" name=\"registration_council\" maxLength={20} isReadOnly value={doctor.registration_council ?? ''} />
      ) : (
        <Select label=\"Registration council\" name=\"registration_council\" options={COUNCILS} value={council} onChange={setCouncil} />
      )}
      <TextField label=\"Registration no.\" name=\"registration_no\" maxLength={30} isReadOnly={ro} value={regNo} onChange={setRegNo} />
      {manage ? <TextField label=\"Phone\" name=\"phone_e164\" maxLength={16} inputMode=\"tel\" isReadOnly={ro} description=\"International format, for example +9779801234567.\" value={phone} onChange={(v) => { setPhone(v); setPhoneErr(undefined); }} {...(phoneErr ? { error: phoneErr } : {})} /> : null}
      {manage ? <TextField label=\"Email\" name=\"email\" maxLength={254} inputMode=\"email\" isReadOnly={ro} value={email} onChange={(v) => { setEmail(v); setEmailErr(undefined); }} {...(emailErr ? { error: emailErr } : {})} /> : null}
      <TextArea label=\"Notes\" name=\"notes\" maxLength={500} isReadOnly={ro} value={notes} onChange={setNotes} />
      {!ro ? <Switch label=\"Active\" isSelected={active} onChange={setActive} /> : null}
      <p>{doctor.price_list_id ? <a className=\"lims-link\" href={`/catalog/price-lists/${doctor.price_list_id}`}>Price list</a> : 'Price list: none assigned (assign it in Price lists).'}</p>
    </>
  );

  return (
    <section aria-label=\"Doctor\">
      <PageHeader
        title={doctor.display_name}
        helpKey=\"catalog.doctors\"
        breadcrumbs={[{ label: 'Catalog', href: '/catalog' }, { label: 'Doctors', href: '/catalog/doctors' }, { label: doctor.doctor_code }]}
        status={
          <>
            <Badge tone={doctor.is_verified ? 'success' : 'warning'}>{doctor.is_verified ? 'Verified' : 'Unverified'}</Badge>
            {doctor.is_active ? null : <Badge tone=\"neutral\">Inactive</Badge>}
          </>
        }
        actions={
          manage && !merged && doctor.is_active ? (
            <>
              {doctor.is_verified ? null : <Button variant=\"primary\" isDisabled={verifying} onPress={() => void verify()}>Verify</Button>}
              <Button onPress={() => setMerging(true)}>Merge into…</Button>
            </>
          ) : null
        }
      />
      {merged ? (
        <p role=\"note\">
          Merged into{' '}
          <a className=\"lims-link\" href={`/catalog/doctors/${doctor.merged_into_id}`}>{target ? `${target.doctor_code} — ${target.display_name}` : 'the doctor it was merged into'}</a>. Past orders keep this doctor.
        </p>
      ) : null}
      {verifyBanner ? <Banner tone=\"warning\" title={verifyBanner} action={{ label: 'Refresh', onPress: () => router.refresh() }} /> : null}
      {ro ? (
        <div className=\"lims-form\">{fields}</div>
      ) : (
        <SaveForm savedText=\"Doctor saved.\" keepOpen reloadLabel=\"Refresh\" check={check} onDuplicate={() => undefined} save={save}>
          {fields}
        </SaveForm>
      )}
      {merging ? <DoctorMergeDialog source={{ id: doctor.id, doctor_code: doctor.doctor_code, display_name: doctor.display_name, version: doctor.version }} targets={mergeTargets} onClose={() => setMerging(false)} /> : null}
    </section>
  );
}

'use client';
// SCR-11 merge dialog (AC-11.3): target = verified, active doctor other than the source; the user types the SOURCE code to confirm.
// One Idempotency-Key per open (a retry after a failure repeats the same request); a second press while in flight is ignored.
import { useId, useRef, useState } from 'react';
import { useRouter } from 'next/navigation';
import { Banner } from '@lims/ui/components/Banner';
import { Button } from '@lims/ui/components/Button';
import { Dialog } from '@lims/ui/components/Dialog';
import { Form } from '@lims/ui/components/Form';
import { TextField } from '@lims/ui/components/TextField';
import { useToast } from '@lims/ui/components/Toast';
import { mergeDoctorAction } from '../server/catalogActions';
import type { DoctorSummary } from '../server/types';
import { CONFLICT, MFA } from './master-ui';

export type MergeSource = { id: string; doctor_code: string; display_name: string; version?: number };

/** Small ARIA combobox over a short, already-loaded list (the kit Combobox only lists options after typing). */
function TargetCombobox({ label, options, value, onChange }: { label: string; options: readonly DoctorSummary[]; value: DoctorSummary | undefined; onChange: (d: DoctorSummary) => void }) {
  const id = useId();
  const [text, setText] = useState('');
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState(0);
  const needle = text.trim().toLowerCase();
  const shown = value && text === `${value.doctor_code} — ${value.display_name}` ? options : options.filter((o) => !needle || `${o.doctor_code} ${o.display_name}`.toLowerCase().includes(needle));
  const pick = (d: DoctorSummary) => {
    onChange(d);
    setText(`${d.doctor_code} — ${d.display_name}`);
    setOpen(false);
  };
  return (
    <div className=\"lims-field\">
      <label className=\"lims-label\" htmlFor={`${id}-in`}>{label}</label>
      <input
        id={`${id}-in`}
        className=\"lims-input\"
        role=\"combobox\"
        aria-expanded={open}
        aria-autocomplete=\"list\"
        aria-controls={open ? `${id}-list` : undefined}
        aria-activedescendant={open && shown[active] ? `${id}-o${active}` : undefined}
        autoComplete=\"off\"
        value={text}
        onChange={(e) => { setText(e.target.value); setOpen(true); setActive(0); }}
        onFocus={() => setOpen(true)}
        onClick={() => setOpen(true)}
        onBlur={() => setOpen(false)}
        onKeyDown={(e) => {
          if (e.key === 'ArrowDown') { e.preventDefault(); setOpen(true); setActive((a) => Math.min(a + 1, shown.length - 1)); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); setActive((a) => Math.max(a - 1, 0)); }
          else if (e.key === 'Enter' && open && shown[active]) { e.preventDefault(); pick(shown[active]!); }
          else if (e.key === 'Escape' && open) { e.stopPropagation(); setOpen(false); }
        }}
      />
      {open ? (
        <ul id={`${id}-list`} role=\"listbox\" aria-label={label} className=\"lims-listbox\" onMouseDown={(e) => e.preventDefault()}>
          {shown.length === 0 ? <li role=\"presentation\" className=\"lims-option\">No matching doctor.</li> : null}
          {shown.map((o, i) => (
            <li key={o.id} id={`${id}-o${i}`} role=\"option\" aria-selected={value?.id === o.id} className=\"lims-option\" onClick={() => pick(o)}>
              {`${o.doctor_code} — ${o.display_name}`}
            </li>
          ))}
        </ul>
      ) : null}
    </div>
  );
}

export function DoctorMergeDialog({ source, targets, onClose }: { source: MergeSource; targets: readonly DoctorSummary[]; onClose: () => void }) {
  const router = useRouter();
  const toast = useToast();
  const [key] = useState(() => crypto.randomUUID());
  const [target, setTarget] = useState<DoctorSummary>();
  const [typed, setTyped] = useState('');
  const [banner, setBanner] = useState<'conflict' | 'mfa' | 'error' | null>(null);
  const [busy, setBusy] = useState(false);
  const inFlight = useRef(false);
  const options = targets.filter((t) => t.is_verified && t.is_active && t.id !== source.id);
  const ready = !!target && typed === source.doctor_code; // exact: no trimming

  const submit = async () => {
    if (!ready || inFlight.current) return;
    inFlight.current = true;
    setBusy(true);
    setBanner(null);
    try {
      const r = await mergeDoctorAction(source.id, target.id, key, source.version);
      if (r.ok) {
        onClose();
        toast.show({ tone: 'success', title: `Merged into ${target.doctor_code}` });
        router.refresh();
      } else setBanner(r.code === 'common.version_conflict' ? 'conflict' : r.code === 'auth.mfa_required' ? 'mfa' : 'error');
    } finally {
      inFlight.current = false;
      setBusy(false);
    }
  };

  return (
    <Dialog title={`Merge ${source.doctor_code} into another doctor`} isOpen onClose={onClose} size=\"md\">
      <Form onSubmit={submit} errorSummary={false}>
        {banner === 'conflict' ? <Banner tone=\"warning\" title={CONFLICT} action={{ label: 'Refresh', onPress: () => router.refresh() }} /> : null}
        {banner === 'mfa' ? <div role=\"alert\"><Banner tone=\"warning\" title={MFA} /></div> : null}
        {banner === 'error' ? <div role=\"alert\"><Banner tone=\"danger\" title=\"Could not merge. Check that the target is a verified, active doctor and try again.\" /></div> : null}
        <TargetCombobox label=\"Target doctor\" options={options} value={target} onChange={setTarget} />
        <p>
          {`Past orders keep the original doctor. Reports and analytics will show ${target ? `${target.display_name} (${target.doctor_code})` : 'the target doctor'}.`}
        </p>
        <TextField label={`Type ${source.doctor_code} to confirm`} name=\"confirm\" maxLength={20} autoComplete=\"off\" value={typed} onChange={setTyped} />
        <Button type=\"submit\" variant=\"danger\" isDisabled={!ready || busy}>Merge</Button>
      </Form>
    </Dialog>
  );
}

'use client';
// SCR-11 Doctors list (04-UI-UX §4). Verified / Status / Source filters travel as URL params (the page re-fetches); the search box
// POSTs to /doctors/search so a name never appears in a URL (D-C3-06). Summaries carry no phone/email, so the list shows none.
// Columns Source and Price list from the spec are not in DoctorSummary [CONV: omitted].
import { useRef, useState, type FormEvent } from 'react';
import { usePathname, useRouter, useSearchParams } from 'next/navigation';
import { Badge } from '@lims/ui/components/Badge';
import { Banner } from '@lims/ui/components/Banner';
import { Button } from '@lims/ui/components/Button';
import { CodeField } from '@lims/ui/components/CodeField';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { Select } from '@lims/ui/components/Select';
import { TextArea } from '@lims/ui/components/TextArea';
import { TextField } from '@lims/ui/components/TextField';
import { createDoctorAction, searchDoctorsAction } from '../server/catalogActions';
import { PARTY_CODE_RE, emailError, phoneError, type DoctorSummary } from '../server/types';
import { DUPLICATE, EditorDialog, MasterTable, StatusBadge, useListShortcuts, type Col } from './master-ui';
import { canManageDoctors } from './DoctorDetail';
import { t } from '@/core/i18n/messages';

const COUNCILS = [{ value: 'none', label: 'None' }, { value: 'NMC', label: 'NMC' }, { value: 'Other', label: 'Other' }] as const;

export function DoctorsList({ doctors, permissions }: { doctors: readonly DoctorSummary[]; permissions: readonly string[] }) {
  const manage = canManageDoctors(permissions);
  const router = useRouter();
  const pathname = usePathname();
  const params = useSearchParams();
  const [creating, setCreating] = useState(false);
  const [q, setQ] = useState('');
  const [results, setResults] = useState<readonly DoctorSummary[] | null>(null);
  const [searchError, setSearchError] = useState(false);
  const [dupes, setDupes] = useState<readonly DoctorSummary[]>([]);
  const openNew = manage ? () => setCreating(true) : undefined;
  useListShortcuts(useRef(null), openNew);

  const setParam = (name: string, value: string) => {
    const p = new URLSearchParams(params.toString());
    if (value === 'all') p.delete(name);
    else p.set(name, value);
    const s = p.toString();
    router.replace(s ? `${pathname}?${s}` : pathname);
  };
  const verified = params.get('is_verified') === 'true' ? 'true' : params.get('is_verified') === 'false' ? 'false' : 'all';
  const active = params.get('is_active') === 'true' ? 'true' : params.get('is_active') === 'false' ? 'false' : 'all';
  const source = ['back_office', 'quick_add', 'import'].includes(params.get('source') ?? '') ? params.get('source')! : 'all';

  const search = async (e: FormEvent) => {
    e.preventDefault();
    setSearchError(false);
    if (!q.trim()) return setResults(null);
    const r = await searchDoctorsAction(q.trim());
    if (r.ok) setResults(r.data);
    else setSearchError(true);
  };

  const rows = results ?? doctors;
  const cols: Col<DoctorSummary>[] = [
    { header: 'Code', cell: (r) => <a className=\"lims-link\" href={`/catalog/doctors/${r.id}`}>{r.doctor_code}</a> },
    { header: 'Name', cell: (r) => r.display_name },
    { header: 'Qualification', cell: (r) => r.qualification ?? '—' },
    { header: 'Verified', cell: (r) => <Badge tone={r.is_verified ? 'success' : 'warning'}>{r.is_verified ? 'Verified' : 'Unverified'}</Badge> },
    { header: 'Status', cell: (r) => <StatusBadge active={r.is_active} /> },
  ];
  return (
    <section aria-label=\"Doctors\">
      <PageHeader
        title={t('catalog.nav.doctors')}
        helpKey=\"catalog.doctors\"
        actions={
          <>
            <a className=\"lims-link\" href=\"/catalog/doctors/verify\">Verify queue</a>
            {openNew ? <Button variant=\"primary\" onPress={openNew}>New doctor</Button> : null}
          </>
        }
      />
      {dupes.length ? (
        <div role=\"status\">
          <Banner tone=\"warning\" title=\"Possible duplicate: a doctor with the same name already exists. The new doctor was saved.\">
            <ul>
              {dupes.map((d) => (
                <li key={d.id}>
                  <a className=\"lims-link\" href={`/catalog/doctors/${d.id}`}>{`${d.doctor_code} — ${d.display_name}`}</a>
                </li>
              ))}
            </ul>
          </Banner>
        </div>
      ) : null}
      {searchError ? <div role=\"alert\"><Banner tone=\"danger\" title=\"The search could not be run. Try again.\" /></div> : null}
      {/* T0D-UNSLOP-1 (LD-344, LD-353 rule 2): search and the radio groups in ONE filter row; the Search button sits next to its input. */}
      <div className=\"lims-filter-bar\">
        <form role=\"search\" onSubmit={(e) => void search(e)}>
          <label className=\"lims-label\" htmlFor=\"doctor-search\">Search doctors</label>
          <input id=\"doctor-search\" className=\"lims-input\" type=\"search\" maxLength={64} autoComplete=\"off\" value={q} onChange={(e) => setQ(e.target.value)} />
          <Button type=\"submit\">Search</Button>
          {results ? <Button variant=\"ghost\" onPress={() => { setResults(null); setQ(''); }}>Clear search</Button> : null}
        </form>
        {/* T0D-UILIST-3 (LD-353 rule 2): selects, not radio groups, so every control in the row has one height */}
        <Select label=\"Verified\" name=\"is_verified\" value={verified} onChange={(v) => setParam('is_verified', v)} options={[{ value: 'all', label: 'All' }, { value: 'true', label: 'Verified' }, { value: 'false', label: 'Unverified' }]} />
        <Select label=\"Status\" name=\"is_active\" value={active} onChange={(v) => setParam('is_active', v)} options={[{ value: 'all', label: 'All' }, { value: 'true', label: 'Active' }, { value: 'false', label: 'Inactive' }]} />
        <Select label=\"Source\" name=\"source\" value={source} onChange={(v) => setParam('source', v)} options={[{ value: 'all', label: 'All' }, { value: 'back_office', label: 'Back office' }, { value: 'quick_add', label: 'Quick add' }, { value: 'import', label: 'Import' }]} />
      </div>
      <MasterTable caption=\"Doctors\" cols={cols} rows={rows} empty=\"No doctors in Doctor Management yet.\" emptyAction={openNew ? { label: 'New doctor', onPress: openNew } : undefined} codeOf={(r) => r.doctor_code} />
      {creating ? <DoctorDialog onClose={() => setCreating(false)} onDuplicates={setDupes} /> : null}
    </section>
  );
}

/** Back-office create (AC-11.1): is_verified / source / quick_add are server-side; a blank code is auto-assigned. */
function DoctorDialog({ onClose, onDuplicates }: { onClose: () => void; onDuplicates: (d: readonly DoctorSummary[]) => void }) {
  const [code, setCode] = useState('');
  const [name, setName] = useState('');
  const [qualification, setQualification] = useState('');
  const [council, setCouncil] = useState<string>('none');
  const [regNo, setRegNo] = useState('');
  const [phone, setPhone] = useState('');
  const [email, setEmail] = useState('');
  const [notes, setNotes] = useState('');
  const [codeError, setCodeError] = useState<string>();
  const [phoneErr, setPhoneErr] = useState<string>();
  const [emailErr, setEmailErr] = useState<string>();
  const filled = (k: string, v: string) => (v.trim() ? { [k]: v.trim() } : {});
  return (
    <EditorDialog
      title=\"New doctor\"
      savedText=\"Doctor saved.\"
      reloadLabel=\"Refresh\"
      onClose={onClose}
      onDuplicate={() => setCodeError(DUPLICATE)}
      check={() => {
        const p = phoneError(phone.trim());
        const e = emailError(email.trim());
        setPhoneErr(p);
        setEmailErr(e);
        return !p && !e;
      }}
      onSaved={(d) => onDuplicates((d as { possible_duplicate_of?: DoctorSummary[] }).possible_duplicate_of ?? [])}
      save={(key) =>
        createDoctorAction(
          { ...filled('doctor_code', code), display_name: name.trim(), ...filled('qualification', qualification), ...(council !== 'none' ? { registration_council: council } : {}), ...filled('registration_no', regNo), ...filled('phone_e164', phone), ...filled('email', email), ...filled('notes', notes) },
          key,
        )
      }
    >
      <CodeField label=\"Doctor code\" name=\"doctor_code\" maxLength={20} pattern={PARTY_CODE_RE.source} patternHint=\"Capital letters, digits, _ and -, up to 20.\" description=\"Leave blank to assign one automatically.\" value={code} onChange={(v) => { setCode(v); setCodeError(undefined); }} {...(codeError ? { error: codeError } : {})} />
      <TextField label=\"Display name\" name=\"display_name\" maxLength={120} isRequired value={name} onChange={setName} />
      <TextField label=\"Qualification\" name=\"qualification\" maxLength={120} value={qualification} onChange={setQualification} />
      <Select label=\"Registration council\" name=\"registration_council\" options={COUNCILS} value={council} onChange={setCouncil} />
      <TextField label=\"Registration no.\" name=\"registration_no\" maxLength={30} value={regNo} onChange={setRegNo} />
      <TextField label=\"Phone\" name=\"phone_e164\" maxLength={16} inputMode=\"tel\" description=\"International format, for example +9779801234567.\" value={phone} onChange={(v) => { setPhone(v); setPhoneErr(undefined); }} {...(phoneErr ? { error: phoneErr } : {})} />
      <TextField label=\"Email\" name=\"email\" maxLength={254} inputMode=\"email\" value={email} onChange={(v) => { setEmail(v); setEmailErr(undefined); }} {...(emailErr ? { error: emailErr } : {})} />
      <TextArea label=\"Notes\" name=\"notes\" maxLength={500} value={notes} onChange={setNotes} />
    </EditorDialog>
  );
}

'use client';
// SCR-11 verify queue (/catalog/doctors/verify): unverified doctors, newest first (the page sorts), possible duplicates under each
// row, actions Verify · Merge into… · Edit for catalog.referrer.manage. Rows are summaries without `version`, so the actions read
// the current version on the server (verifyDoctorAction / mergeDoctorAction without a version).
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { Banner } from '@lims/ui/components/Banner';
import { Button } from '@lims/ui/components/Button';
import { PageHeader } from '@lims/ui/components/PageHeader';
import { useToast } from '@lims/ui/components/Toast';
import { verifyDoctorAction } from '../server/catalogActions';
import type { DoctorSummary } from '../server/types';
import { CONFLICT, MasterTable, type Col } from './master-ui';
import { canManageDoctors } from './DoctorDetail';
import { DoctorMergeDialog } from './DoctorMergeDialog';

export function DoctorVerifyQueue({ doctors, possibleDuplicates = {}, mergeTargets, permissions }: {
  doctors: readonly DoctorSummary[];
  possibleDuplicates?: Readonly<Record<string, readonly DoctorSummary[]>>;
  mergeTargets: readonly DoctorSummary[];
  permissions: readonly string[];
}) {
  const manage = canManageDoctors(permissions);
  const router = useRouter();
  const toast = useToast();
  const [busy, setBusy] = useState<string | null>(null);
  const [banner, setBanner] = useState<string>();
  const [merging, setMerging] = useState<DoctorSummary>();

  const verify = async (d: DoctorSummary) => {
    if (busy) return;
    setBusy(d.id);
    setBanner(undefined);
    try {
      const r = await verifyDoctorAction(d.id);
      if (r.ok) {
        toast.show({ tone: 'success', title: `Verified ${d.doctor_code}` });
        router.refresh();
      } else setBanner(r.code === 'common.version_conflict' ? CONFLICT : 'Could not verify. Try again.');
    } finally {
      setBusy(null);
    }
  };

  const cols: Col<DoctorSummary>[] = [
    { header: 'Code', cell: (r) => r.doctor_code },
    {
      header: 'Name',
      cell: (r) => {
        const dupes = possibleDuplicates[r.id] ?? [];
        return (
          <>
            <a className=\"lims-link\" href={`/catalog/doctors/${r.id}`}>{r.display_name}</a>
            {dupes.length ? (
              <div>
                Possible duplicates:{' '}
                {dupes.map((x, i) => (
                  <span key={x.id}>
                    {i ? ', ' : ''}
                    <a className=\"lims-link\" href={`/catalog/doctors/${x.id}`}>{x.display_name}</a> ({x.doctor_code})
                  </span>
                ))}
              </div>
            ) : null}
          </>
        );
      },
    },
    { header: 'Qualification', cell: (r) => r.qualification ?? '—' },
  ];
  return (
    <section aria-label=\"Doctors waiting for verification\">
      <PageHeader title=\"Verify doctors\" helpKey=\"catalog.doctors\" breadcrumbs={[{ label: 'Catalog', href: '/catalog' }, { label: 'Doctors', href: '/catalog/doctors' }, { label: 'Verify' }]} />
      {banner ? <Banner tone=\"warning\" title={banner} action={{ label: 'Refresh', onPress: () => router.refresh() }} /> : null}
      <MasterTable
        caption=\"Doctors waiting for verification\"
        cols={cols}
        rows={doctors}
        empty=\"No doctors waiting for verification.\"
        codeOf={(r) => r.doctor_code}
        rowExtra={
          manage
            ? (r) => (
                <>
                  <Button size=\"sm\" variant=\"primary\" isDisabled={busy !== null} onPress={() => void verify(r)}>Verify</Button>
                  <Button size=\"sm\" onPress={() => setMerging(r)}>Merge into…</Button>
                  <Button size=\"sm\" onPress={() => router.push(`/catalog/doctors/${r.id}`)}>Edit</Button>
                </>
              )
            : undefined
        }
      />
      {merging ? <DoctorMergeDialog source={{ id: merging.id, doctor_code: merging.doctor_code, display_name: merging.display_name }} targets={mergeTargets} onClose={() => setMerging(undefined)} /> : null}
    </section>
  );
}

'use client';
// SCR-07 formula field (F-05, AC-04.8): debounced server validation (#36, read-only), Inputs/Order summary, \"Try it\" sample evaluation.
import { useEffect, useState } from 'react';
import { Button } from '@lims/ui/components/Button';
import { DecimalField } from '@lims/ui/components/DecimalField';
import { FormulaEditor } from '@lims/ui/components/FormulaEditor';
import { IntegerField } from '@lims/ui/components/IntegerField';
import { Select } from '@lims/ui/components/Select';
import { validateFormulaAction } from '../server/actions';
import { SEXES, type FormulaValidation } from '../server/types';
import './catalog.css';

const DEBOUNCE_MS = 400;
/** '/expression/4' → 4 (character offset); anything else → 0. */
const positionOf = (path?: string) => {
  const n = Number(path?.split('/').pop());
  return Number.isInteger(n) && n >= 0 ? n : 0;
};

export function FormulaPanel({ analyteId, value, onChange, error, isReadOnly }: {
  analyteId?: string | undefined;
  value: string;
  onChange: (v: string) => void;
  /** Server error from a mutation (e.g. a cycle path), shown under the field. */
  error?: string | undefined;
  isReadOnly?: boolean;
}) {
  const [text, setText] = useState(value);
  const [res, setRes] = useState<FormulaValidation>();
  const [inputs, setInputs] = useState<Record<string, string>>({});
  const [age, setAge] = useState<number>();
  const [sex, setSex] = useState<string>();
  const [tried, setTried] = useState<{ result?: string; reason?: string }>();

  useEffect(() => setText(value), [value]);

  useEffect(() => {
    if (text.trim() === '') {
      setRes(undefined);
      return;
    }
    let live = true;
    const t = setTimeout(() => {
      validateFormulaAction({ ...(analyteId ? { analyte_id: analyteId } : {}), expression: text })
        .then((r) => live && setRes(r.ok ? r.data : undefined))
        .catch(() => undefined); // validation is advisory; the mutation re-checks
    }, DEBOUNCE_MS);
    return () => {
      live = false;
      clearTimeout(t);
    };
  }, [text, analyteId]);

  const codes = res?.valid ? res.input_analyte_codes : [];
  const diagnostics = res && !res.valid ? res.errors.map((e) => ({ message: e.message, position: positionOf(e.path) })) : [];

  const tryIt = async () => {
    const sample_inputs = Object.fromEntries(codes.filter((c) => inputs[c]).map((c) => [c, inputs[c]!]));
    const r = await validateFormulaAction({
      ...(analyteId ? { analyte_id: analyteId } : {}),
      expression: text,
      sample_inputs,
      ...(age !== undefined && sex ? { sample_context: { age_days: age, sex } } : {}),
    }).catch(() => undefined);
    if (!r?.ok) return setTried({ reason: 'The sample could not be evaluated.' });
    setTried({ ...(r.data.sample_result !== undefined ? { result: r.data.sample_result } : {}), ...(r.data.sample_not_computable_reason ? { reason: r.data.sample_not_computable_reason } : {}) });
  };

  return (
    <div className=\"lims-stack catalog-gap-3\">
      <div aria-live=\"polite\">
        <FormulaEditor
          label=\"Formula\"
          name=\"formula_expression\"
          maxLength={500}
          value={text}
          diagnostics={diagnostics}
          {...(error ? { error } : {})}
          {...(isReadOnly ? { isReadOnly: true } : {})}
          onChange={(v) => {
            setText(v);
            setTried(undefined);
            onChange(v);
          }}
        />
        {res?.valid ? (
          <>
            <p>{`Inputs: ${res.input_analyte_codes.join(', ')}`}</p>
            <p>{`Order: ${res.dependency_order.join(' → ')}`}</p>
          </>
        ) : null}
      </div>
      {codes.length > 0 ? (
        // Enter here must not submit the surrounding analyte form; it runs the sample instead.
        <div
          className=\"lims-stack catalog-gap-2\"
          onKeyDown={(e) => {
            if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey) {
              e.preventDefault();
              void tryIt();
            }
          }}
        >
          {codes.map((c) => (
            <DecimalField key={c} label={c} name={`try_${c}`} decimals={6} allowNegative {...(inputs[c] !== undefined ? { value: inputs[c] } : {})} onChange={(v) => setInputs((s) => ({ ...s, [c]: v ?? '' }))} />
          ))}
          <IntegerField label=\"Sample age (days)\" name=\"try_age_days\" min={0} max={73000} {...(age !== undefined ? { value: age } : {})} onChange={setAge} />
          <Select label=\"Sample sex\" name=\"try_sex\" options={SEXES.map((s) => ({ value: s, label: s.charAt(0).toUpperCase() + s.slice(1) }))} {...(sex ? { value: sex as (typeof SEXES)[number] } : {})} onChange={setSex} />
          <div><Button onPress={() => void tryIt()}>Try it</Button></div>
          {tried?.result !== undefined ? <p>{`Result: ${tried.result}`}</p> : null}
          {tried?.reason ? <p>{tried.reason}</p> : null}
        </div>
      ) : null}
    </div>
  );
}

'use client';
// Shared bits of SCR-18 / SCR-19: status + kind labels, issue message catalog (04-UI-UX SCR-19: `catalog.import.issue.<code>`), error copy, kind permissions.
import type { ImportIssue, ImportKind, ImportStatus } from '../server/types';
import type { Fail, Tone } from './shared';

export const IMPORT_PERM = {
  priceListManage: 'catalog.price_list.manage',
  testManage: 'catalog.test.manage',
  referrerManage: 'catalog.referrer.manage',
  referrerExport: 'catalog.referrer.export',
  publish: 'catalog.reference_range.publish',
} as const;

/** 04-UI-UX SCR-18 / 08 A13 P-10: permission(s) the kind needs. Commit on catalog_master also needs the publish permission (AC-17.5, D-18). */
export const KIND_PERMS: Record<ImportKind, readonly string[]> = {
  price_list: [IMPORT_PERM.priceListManage],
  credit_parties: [IMPORT_PERM.priceListManage],
  catalog_master: [IMPORT_PERM.testManage],
  referrers: [IMPORT_PERM.referrerManage],
};
export const COMMIT_PERMS: Record<ImportKind, readonly string[]> = { ...KIND_PERMS, catalog_master: [IMPORT_PERM.testManage, IMPORT_PERM.publish] };
export const KIND_LABEL: Record<ImportKind, string> = { price_list: 'Price list prices', catalog_master: 'Catalog master', referrers: 'Doctors', credit_parties: 'Credit parties' };

export const IMPORT_STATUS_LABEL: Record<ImportStatus, string> = {
  uploaded: 'Uploaded', scanning: 'Security scan', validating: 'Validating', validated: 'Ready to commit', invalid: 'Invalid', quarantined: 'Quarantined',
  committing: 'Committing', committed: 'Committed', commit_failed: 'Commit failed', discarded: 'Discarded', expired: 'Expired', failed: 'Failed',
};
export const EXPORT_STATUS_LABEL: Record<string, string> = { queued: 'Queued', building: 'Building', ready: 'Ready', failed: 'Failed', expired: 'Expired' };

export const TRANSIENT: readonly ImportStatus[] = ['uploaded', 'scanning', 'validating', 'committing'];
export const isTransient = (s: ImportStatus) => TRANSIENT.includes(s);

/** Texts of the known issue codes (TRD §8.7 import issue codes). Templated ones (`{reason}`) are absent on purpose: the API text is shown. */
