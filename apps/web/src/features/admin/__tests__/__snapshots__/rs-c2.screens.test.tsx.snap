<div class="lims-drawer lims-drawer-end lims-drawer-md" data-rac="" style="">
<div style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<button id="#id" aria-label="Dismiss" tabindex="-1" style="width: 1px; height: 1px;">
</button>
</div>
<section class="lims-dialog-body" data-rac="" aria-labelledby="#id" role="dialog" tabindex="-1">
<div class="lims-dialog-header">
<h2 id="#id" slot="title" class="lims-dialog-title">Edit centre</h2>
<button class="lims-btn lims-btn-ghost lims-icon-btn" data-rac="" type="button" tabindex="0" data-#id="true" aria-label="Close" id="#id">
<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M6 6l12 12M18 6L6 18">
</path>
</svg>
</button>
</div>
<div class="lims-dialog-content">
<section class="lims-drawer-section" aria-labelledby="#id">
<div class="lims-drawer-section-header">
<h3 id="#id" class="lims-drawer-section-title">Details</h3>
<button class="lims-btn lims-btn-secondary lims-btn-sm" data-rac="" type="button" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Save<span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); white-space: nowrap; border: 0px;"> Details</span>
</span>
</button>
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Code</label>
<input id="#id" readonly="" class="lims-input" aria-describedby="#id-hint" type="text" value="C01">
<p id="#id-hint" class="lims-description">Printed on reports, e.g. C000000002</p>
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Name</label> <p class="lims-description">Required</p> <input id="#id" class="lims-input" aria-required="true" type="text" value="Central Collection">
</div>
<div class="lims-field">
<label id="#id-lbl" for="#id-btn" class="lims-label">Branch</label>
<button id="#id-btn" type="button" class="lims-input lims-picker" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="#id-lbl #id-btn">Kathmandu lab</button>
</div>
<div role="radiogroup" aria-labelledby="#id-lg" class="lims-field">
<p id="#id-lg" class="lims-label">Type</p>
<span class="lims-check">
<input aria-labelledby="#id-o0" type="radio" checked="" name="kind-#id"> <data id="#id-o0" value="own">Own</data>
</span>
<span class="lims-check">
<input aria-labelledby="#id-o1" type="radio" name="kind-#id"> <data id="#id-o1" value="franchise">Franchise</data>
</span>
<span class="lims-check">
<input aria-labelledby="#id-o2" type="radio" name="kind-#id"> <data id="#id-o2" value="home_collection">Home collection</data>
</span>
</div>
</section>
<section class="lims-drawer-section" aria-labelledby="#id">
