exports[`visual snapshots of the key screens are recorded > snapshot: settings 1`] = `
"<div>
<main class="lims-page">
<header class="lims-page-header">
<h1>Lab settings</h1>
</header>
<div class="lims-tabs">
<div role="tablist" aria-label="Settings sections" class="lims-tablist">
<button id="#id-General-tab" type="button" role="tab" class="lims-tab" aria-selected="true" tabindex="0" aria-controls="#id-General-panel">General</button>
<button id="#id-Datetime-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Date &amp; time</button>
<button id="#id-Signinsessions-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Sign-in &amp; sessions</button>
<button id="#id-Numbering-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Numbering</button>
<button id="#id-Letterheadbranding-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Letterhead &amp; branding</button>
<button id="#id-Reportsdelivery-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Reports &amp; delivery</button>
<button id="#id-Dataretention-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Data retention</button>
<button id="#id-Features-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Features</button>
<button id="#id-BillingIRD-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Billing &amp; IRD</button>
<button id="#id-Laboperations-tab" type="button" role="tab" class="lims-tab" aria-selected="false" tabindex="-1">Lab operations</button>
</div>
<div role="tabpanel" id="#id-General-panel" class="lims-tabpanel" tabindex="0">
<div>
<div class="lims-field">
<label for="#id" class="lims-label">Legal name</label>
<input id="#id" readonly="" class="lims-input" aria-describedby="#id-hint" type="text" value="">
<p id="#id-hint" class="lims-description">Changed by the LIMS provider.</p>
</div>
<div class="lims-field">
<label for="set-display_name" class="lims-label">Display name</label> <p class="lims-description">Required</p> <input id="set-display_name" class="lims-input" maxlength="120" aria-required="true" type="text" value="Synthetic Lab">
</div>
<div class="lims-field">
<label for="set-address_lines" class="lims-label">Address (one line each, up to 4)</label>
<textarea rows="3" id="set-address_lines" class="lims-input">
</textarea>
</div>
<div class="lims-field">
<label for="set-phones" class="lims-label">Phones (one per line, up to 3)</label>
<textarea rows="3" id="set-phones" class="lims-input">
</textarea>
</div>
<div class="lims-field">
<label for="set-contact_email" class="lims-label">Contact email</label>
<input id="set-contact_email" class="lims-input" maxlength="254" type="text" value="lab@example.test">
</div>
<div class="lims-field">
<label for="set-website" class="lims-label">Website</label>
<input id="set-website" class="lims-input" aria-describedby="set-website-hint" maxlength="200" type="text" value="">
<p id="set-website-hint" class="lims-description">https://…</p>
</div>
<div class="lims-field">
<label for="set-receipt_footer_note" class="lims-label">Receipt footer note</label>
<input id="set-receipt_footer_note" class="lims-input" maxlength="200" type="text" value="">
</div>
<div class="lims-field">
<label for="set-accent_color" class="lims-label">Accent colour</label>
<input id="set-accent_color" class="lims-input" aria-describedby="set-accent_color-hint" maxlength="7" type="text" value="">
<p id="set-accent_color-hint" class="lims-description">#RRGGBB</p>
</div>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="button" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Save</span>
</button>
</div>
</div>
</div>
</main>
<div class="lims-toast-region">
</div>
</div>"
`;

exports[`visual snapshots of the key screens are recorded > snapshot: sign-in 1`] = `
"<div>
<div class="lims-auth-card">
<p class="lims-wordmark">LIMS</p>
<h1>Log in</h1>
<form novalidate="">
<div class="lims-field">
<label class="lims-label" for="#id-email">Email</label> <p class="lims-description">Required</p> <input id="#id-email" class="lims-input" autocomplete="username" maxlength="254" required="" type="email" value="" name="email">
</div>
<div class="lims-field">
<label class="lims-label" for="#id">Password</label> <p class="lims-description">Required</p> <div class="lims-input-group">
<input id="#id" class="lims-input" autocomplete="current-password" maxlength="128" required="" type="password" value="" name="password">
<button type="button" class="lims-btn lims-btn-ghost lims-btn-sm" aria-pressed="false">Show</button>
</div>
</div>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="submit" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Log in</span>
</button>
</form>
<a href="/auth/forgot">Forgot password?</a>
</div>
</div>"
`;

