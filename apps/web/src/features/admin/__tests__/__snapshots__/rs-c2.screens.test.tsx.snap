</button>
</div>
</div>
</section>
</div>
</div>
<span data-focus-scope-end="true" hidden="" aria-hidden="true">
</span>"
`;

exports[`visual snapshots of the key screens are recorded > snapshot: roles-edit-privileged 1`] = `
"<div>
<main class="lims-page">
<header class="lims-page-header">
<h1>Lab admin</h1>
<span class="lims-chip lims-chip-sm lims-tone-warning" data-tone="warning">MFA required</span>
</header>
<p>Changing a role logs out everyone who has it.</p>
<div class="lims-field">
<label for="#id" class="lims-label">Name</label> <p class="lims-description">Required</p> <input id="#id" class="lims-input" maxlength="80" aria-required="true" type="text" value="Lab admin">
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Code</label>
<input id="#id" readonly="" class="lims-input" aria-describedby="#id-hint" type="text" value="lab_admin">
<p id="#id-hint" class="lims-description">The code cannot change after the role is created.</p>
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Description</label>
<textarea rows="3" id="#id" class="lims-input">
</textarea>
</div>
<label data-#id="true" class="lims-switch" data-rac="" data-selected="true" data-disabled="true">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input disabled="" data-#id="true" role="switch" type="checkbox" checked="">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>MFA required</label>
<p class="lims-description">Includes privileged permissions</p>
<div class="lims-banner lims-tone-warning" data-tone="warning">
<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 4l9 16H3L12 4zM12 10v4M12 17h.01">
</path>
</svg>
<div class="lims-banner-text">
<p class="lims-banner-title">
<span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); white-space: nowrap; border: 0px;">Warning: </span>Members with these permissions who process samples from other collection centres need All centres or every collection centre whose samples they process.</p>
</div>
</div>
<table role="grid" aria-label="Permissions" class="lims-table lims-permmatrix">
<thead>
<tr role="row">
<th role="columnheader" scope="col">Module</th>
<th role="columnheader" scope="col">user</th>
<th role="columnheader" scope="col">order</th>
<th role="columnheader" scope="col">result</th>
<th role="columnheader" scope="col">tenant</th>
</tr>
</thead>
<tbody>
<tr role="row">
<th role="rowheader" scope="row">identity</th>
<td role="gridcell">
<div class="lims-perm">
<label class="lims-check">
<input tabindex="0" type="checkbox">
<span class="lims-mono">identity.user.read</span>
</label>
</div>
</td>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
</tr>
<tr role="row">
<th role="rowheader" scope="row">frontdesk</th>
<td role="gridcell">
</td>
<td role="gridcell">
<div class="lims-perm">
<label class="lims-check">
<input tabindex="-1" type="checkbox">
<span class="lims-mono">frontdesk.order.read</span>
</label>
</div>
</td>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
</tr>
<tr role="row">
<th role="rowheader" scope="row">lab</th>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
<td role="gridcell">
<div class="lims-perm">
<label class="lims-check">
<input tabindex="-1" type="checkbox" checked="">
<span class="lims-mono">lab.result.approve</span>
</label>
<span class="lims-chip lims-chip-sm lims-tone-warning" data-tone="warning">
<svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 4l9 16H3L12 4zM12 10v4M12 17h.01">
</path>
</svg>Privileged</span>
</div>
</td>
<td role="gridcell">
</td>
</tr>
<tr role="row">
<th role="rowheader" scope="row">platform</th>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
<td role="gridcell">
</td>
<td role="gridcell">
<div class="lims-perm">
<label class="lims-check">
<input disabled="" tabindex="-1" aria-describedby="#id-platform.tenant.manage-why" type="checkbox">
<span class="lims-mono">platform.tenant.manage</span>
</label>
<span class="lims-chip lims-chip-sm lims-tone-warning" data-tone="warning">
<svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 4l9 16H3L12 4zM12 10v4M12 17h.01">
</path>
</svg>Privileged</span>
<span id="#id-platform.tenant.manage-why" class="lims-description">Managed by the LIMS provider</span>
</div>
</td>
</tr>
</tbody>
</table>
<footer class="lims-form-footer">
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="button" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Save</span>
</button>
<span>
<button class="lims-btn lims-btn-danger lims-btn-md" data-rac="" type="button" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Deactivate role</span>
</button>
</span>
</footer>
</main>
<div class="lims-toast-region">
</div>
</div>"
