<button class="lims-btn lims-btn-secondary lims-btn-sm" data-rac="" type="button" tabindex="0" data-#id="true" id="#id">
<span class="lims-btn-label">Save<span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); white-space: nowrap; border: 0px;"> Contact</span>
</span>
</button>
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Address</label>
<textarea rows="3" id="#id" class="lims-input">Synthetic Road 1</textarea>
</div>
<div class="lims-field">
<label for="#id" class="lims-label">Phone</label>
<input id="#id" class="lims-input" type="tel" value="+97711111111">
</div>
</section>
<div class="lims-dialog-footer">
