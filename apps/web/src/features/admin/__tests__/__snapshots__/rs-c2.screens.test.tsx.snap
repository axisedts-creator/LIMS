<td role="gridcell">
<button type="button" class="lims-link">Central Collection</button>
</td>
<td role="gridcell">Kathmandu lab</td>
<td role="gridcell">Own</td>
<td role="gridcell">+97711111111</td>
<td role="gridcell">Active</td>
</tr>
</tbody>
</table>
</main>
<div class="lims-toast-region">
</div>
</div>
<span data-focus-scope-start="true" hidden="" aria-hidden="true">
</span>
