<span id="ID" class="aria-id" data-rac="">Cash</span>
<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M6 9l6 6 6-6">
</path>
</svg>
</button>
<div style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: fixed; width: 1px; white-space: nowrap; top: 0px; left: 0px;" aria-hidden="true" data-aria-id="true" data-a11y-ignore="aria-hidden-focus" data-testid="hidden-select-container">
<label>
<select tabindex="-1" name="method_0">
<option value="" label="&nbsp;">&nbsp;</option>
<option value="cash">Cash</option>
</select>
</label>
</div>
</div>
<div data-field="amount-0">
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Amount</label>
<div class="lims-input-group">
<span class="lims-affix">Rs.</span>
<input inputmode="decimal" tabindex="0" id="ID" aria-labelledby="ID" class="lims-input" data-rac="" type="text" value="0.00" name="amount_0">
</div>
</div>
</div>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Reference</label>
<div class="lims-input-group">
<input maxlength="100" tabindex="0" id="ID" aria-labelledby="ID" class="lims-input" data-rac="" type="text" value="" name="reference_0">
</div>
</div>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Tendered</label>
<div class="lims-input-group">
<span class="lims-affix">Rs.</span>
<input inputmode="decimal" tabindex="0" id="ID" aria-labelledby="ID" class="lims-input" data-rac="" type="text" value="" name="tendered_0">
</div>
</div>
</div>
<button class="lims-btn lims-btn-ghost lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 5v14M5 12h14">
</path>
</svg>
<span class="lims-btn-label">Add method</span>
<kbd class="lims-kbd" aria-hidden="true">Alt+P</kbd>
</button>
<div role="status">
<span>Balance after payment</span> <span class="lims-money">Rs. 0.00</span>
</div>
</div>
</div>
</div>
</div>
<aside class="lims-reg-summary" aria-label="Registration summary">
<h2 class="lims-reg-summary-title">Summary</h2>
<dl class="lims-reg-summary-list">
<div class="lims-reg-summary-row">
<dt>Tests</dt>
<dd>None yet</dd>
</div>
<div class="lims-reg-summary-row">
<dt>Total</dt>
<dd>
<span class="lims-money">
<span>Rs.</span> <span>0.00</span>
</span>
</dd>
</div>
<div class="lims-reg-summary-row">
<dt>Paid</dt>
<dd>
<span class="lims-money">
<span>Rs.</span> <span>0.00</span>
</span>
</dd>
</div>
<div class="lims-reg-summary-row lims-reg-summary-balance">
<dt>Balance</dt>
<dd>
<span class="lims-money">
<span>Rs.</span> <span>0.00</span>
</span>
</dd>
</div>
<div class="lims-reg-summary-row">
<dt>Discount authority</dt>
<dd>—</dd>
</div>
</dl>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="submit" disabled="" data-aria-id="true" id="ID" data-disabled="true">
<span class="lims-btn-label">Register &amp; print</span>
<kbd class="lims-kbd" aria-hidden="true">Ctrl+Enter</kbd>
</button>
</aside>
</div>
<div>
</div>
</section>
<div class="lims-toast-region">
</div>"
`;

