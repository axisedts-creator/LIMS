</p>
</div>
<div class="lims-card">
<h2 class="lims-card-title">Billing</h2>
<div class="lims-reg-section">
<div class="lims-field lims-radio-group" data-rac="" role="radiogroup" aria-orientation="horizontal" id="ID" aria-labelledby="ID" data-orientation="horizontal">
<span class="lims-label" id="ID">Billing mode</span>
<div class="lims-radio-options lims-horizontal">
<label data-aria-id="true" class="lims-radio" data-rac="" data-selected="true">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="0" type="radio" value="cash" checked="" name="billing_mode">
</span>
<span class="lims-radio-dot" aria-hidden="true">
</span>Cash</label>
<label data-aria-id="true" class="lims-radio" data-rac="">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="-1" type="radio" value="credit" name="billing_mode">
</span>
<span class="lims-radio-dot" aria-hidden="true">
</span>Credit</label>
</div>
</div>
<div role="status" aria-live="polite">
</div>
<button class="lims-btn lims-btn-ghost lims-btn-md" data-rac="" type="button" disabled="" data-aria-id="true" id="ID" data-disabled="true">
