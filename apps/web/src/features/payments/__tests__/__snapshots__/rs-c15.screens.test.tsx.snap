<span style="position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); white-space: nowrap; border: 0px;">Note: </span>Environment: Production</p>
</div>
</div>
<div class="lims-card">
<h2 class="lims-card-title">eSewa</h2>
<span class="lims-chip lims-chip-md lims-tone-success" data-tone="success">
<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6">
</path>
</svg>Enabled</span>
<label data-aria-id="true" class="lims-switch" data-rac="" data-selected="true">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="0" role="switch" type="checkbox" checked="">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>Enabled</label>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Product code</label>
<div class="lims-input-group">
<input maxlength="64" tabindex="0" id="ID" aria-labelledby="ID" class="lims-input" data-rac="" type="text" value="SYNTH" name="esewa_product_code">
</div>
</div>
<p>Set · fingerprint ab12cd34</p>
<div class="lims-field">
<label class="lims-label" for="_r_hl_">Replace secret key</label>
<div class="lims-input-group">
<input id="_r_hl_" class="lims-input" autocomplete="new-password" maxlength="256" type="password" value="" name="secret_input">
</div>
</div>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<span class="lims-btn-label">Save</span>
</button>
<button class="lims-btn lims-btn-secondary lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<span class="lims-btn-label">Test connection</span>
</button>
</div>
<div class="lims-card">
<h2 class="lims-card-title">Khalti</h2>
<span class="lims-chip lims-chip-md lims-tone-neutral" data-tone="neutral">
<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 3a9 9 0 100 18 9 9 0 000-18z">
</path>
</svg>Disabled</span>
<label data-aria-id="true" class="lims-switch" data-rac="">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="0" role="switch" type="checkbox">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>Enabled</label>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Website URL</label>
<div class="lims-input-group">
<input maxlength="300" tabindex="0" id="ID" aria-labelledby="ID" aria-describedby="ID" class="lims-input" data-rac="" type="text" value="https://synthetic.example" name="khalti_website_url">
</div>
<span class="lims-description" id="ID" slot="description">Khalti requires your website address.</span>
</div>
<label data-aria-id="true" class="lims-switch" data-rac="">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="0" role="switch" type="checkbox">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>Use Khalti refund API</label>
<p class="lims-description">Only after the LIMS provider has confirmed the refund API in the sandbox. Otherwise refunds are done in the Khalti dashboard.</p>
<div class="lims-field">
<label class="lims-label" for="_r_i3_">Secret key</label>
<div class="lims-input-group">
<input id="_r_i3_" class="lims-input" autocomplete="new-password" maxlength="256" type="password" value="" name="secret_input">
</div>
</div>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<span class="lims-btn-label">Save</span>
</button>
<button class="lims-btn lims-btn-secondary lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<span class="lims-btn-label">Test connection</span>
</button>
</div>
<div class="lims-card">
<h2 class="lims-card-title">Fonepay</h2>
<span class="lims-chip lims-chip-md lims-tone-neutral" data-tone="neutral">
<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lims-icon">
<path d="M12 3a9 9 0 100 18 9 9 0 000-18z">
</path>
</svg>Not available yet</span>
<p>Waiting for the Fonepay merchant integration document from your bank (blocker B8).</p>
<label data-aria-id="true" class="lims-switch" data-rac="" data-disabled="true">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input disabled="" data-aria-id="true" role="switch" type="checkbox">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>Enabled</label>
</div>
<div class="lims-card">
<h2 class="lims-card-title">Refunds and labels</h2>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Two-person threshold</label>
<div class="lims-input-group">
<span class="lims-affix">Rs.</span>
<input inputmode="decimal" tabindex="0" id="ID" aria-labelledby="ID" aria-describedby="ID" class="lims-input" data-rac="" type="text" value="10,000.00" name="refund_two_person_threshold">
</div>
<span class="lims-description" id="ID" slot="description">Refunds above this amount always need a second approver. 0 = always.</span>
</div>
<div class="lims-field" data-rac="">
<label class="lims-label" id="ID" for="ID">Order label sent to Khalti</label>
<div class="lims-input-group">
<input maxlength="50" tabindex="0" id="ID" aria-labelledby="ID" aria-describedby="ID" class="lims-input" data-rac="" type="text" value="PO number" name="purchase_order_label">
</div>
<span class="lims-description" id="ID" slot="description">Shown to the patient on the Khalti page. Do not include patient or test names.</span>
</div>
<label data-aria-id="true" class="lims-switch" data-rac="" data-selected="true">
<span style="border: 0px; clip: rect(0px 0px 0px 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;">
<input data-aria-id="true" tabindex="0" role="switch" type="checkbox" checked="">
</span>
<span class="lims-switch-track" aria-hidden="true">
<span class="lims-switch-thumb">
</span>
</span>Nightly reconciliation</label>
<button class="lims-btn lims-btn-primary lims-btn-md" data-rac="" type="button" tabindex="0" data-aria-id="true" id="ID">
<span class="lims-btn-label">Save</span>
</button>
</div>
<div class="lims-toast-region">
</div>"
`;

