{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lims:event:engagement.booking.confirmed.v1",
  "allOf": [
    {
      "$ref": "urn:lims:event:_envelope.v1"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "engagement.booking.confirmed.v1"
        },
        "producer": {
          "const": "engagement"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "booking"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking_id",
        "patient_id",
        "branch_id",
        "centre_id",
        "booking_kind",
        "slot_start",
        "slot_end",
        "orderable_ids",
        "confirmed_at"
      ],
      "properties": {
        "booking_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "patient_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "branch_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "centre_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "booking_kind": {
          "enum": [
            "centre_visit",
            "home_collection"
          ]
        },
        "slot_start": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "slot_end": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "orderable_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
          }
        },
        "home_address_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "referrer_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "confirmed_at": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        }
      }
    }
  }
}
