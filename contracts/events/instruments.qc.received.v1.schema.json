{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lims:event:instruments.qc.received.v1",
  "allOf": [
    {
      "$ref": "urn:lims:event:_envelope.v1"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "instruments.qc.received.v1"
        },
        "producer": {
          "const": "instruments"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "instrument_message"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_message_id",
        "instrument_id",
        "centre_id",
        "control_id_raw",
        "instrument_analyte_code",
        "mapping_status",
        "value_raw",
        "received_at"
      ],
      "properties": {
        "instrument_message_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "instrument_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "centre_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "control_id_raw": {
          "type": "string",
          "maxLength": 64
        },
        "control_lot_raw": {
          "type": "string",
          "maxLength": 64
        },
        "control_level": {
          "type": "string",
          "maxLength": 16
        },
        "instrument_analyte_code": {
          "type": "string",
          "maxLength": 64
        },
        "mapping_status": {
          "enum": [
            "mapped",
            "unmapped"
          ]
        },
        "analyte_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "value_raw": {
          "type": "string",
          "maxLength": 64
        },
        "value_numeric": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/DecimalString"
        },
        "unit_raw": {
          "type": "string",
          "maxLength": 32
        },
        "instrument_flags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 16
          }
        },
        "instrument_result_time": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "received_at": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "captured_at": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "processing_kind": {
          "enum": [
            "live",
            "reprocess",
            "rematch"
          ]
        }
      }
    }
  }
}
