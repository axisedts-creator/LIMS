{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lims:event:lab.result.amended.v1",
  "allOf": [
    {
      "$ref": "urn:lims:event:_envelope.v1"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "lab.result.amended.v1"
        },
        "producer": {
          "const": "lab"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "result"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "previous_version_no",
        "new_version_no",
        "order_id",
        "order_item_id",
        "test_id",
        "analyte_id",
        "amendment_reason_code",
        "amended_at",
        "amended_by_membership_id"
      ],
      "properties": {
        "result_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "previous_version_no": {
          "type": "integer",
          "minimum": 1
        },
        "new_version_no": {
          "type": "integer",
          "minimum": 2
        },
        "order_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "order_item_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "test_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "analyte_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "amendment_reason_code": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Code"
        },
        "amended_at": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "amended_by_membership_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        }
      }
    }
  }
}
