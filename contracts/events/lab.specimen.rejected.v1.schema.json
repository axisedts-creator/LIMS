{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lims:event:lab.specimen.rejected.v1",
  "allOf": [
    {
      "$ref": "urn:lims:event:_envelope.v1"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "lab.specimen.rejected.v1"
        },
        "producer": {
          "const": "lab"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "specimen"
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimen_id",
        "order_id",
        "patient_id",
        "centre_id",
        "reason_code",
        "rejected_at",
        "recollection_required",
        "order_item_ids"
      ],
      "properties": {
        "specimen_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "order_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "patient_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "centre_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "reason_code": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Code"
        },
        "rejected_at": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/IsoUtc"
        },
        "recollection_required": {
          "type": "boolean"
        },
        "collected_by_membership_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "home_visit_id": {
          "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
        },
        "order_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "urn:lims:event:_defs.v1#/$defs/Uuidv7"
          }
        }
      }
    }
  }
}
