{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lims:render:analytics.report",
  "title": "analytics.report render data (02-TRD 10.2 step 6a; created per LD-85 / AN-T15b)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantDisplayName", "reportTitle", "periodLabelAd", "periodLabelBs", "scopeLabel", "generatedAtLocal", "exportId", "exportedBy", "freshnessNote", "notStatutoryNote", "columns", "rows"],
  "properties": {
    "tenantDisplayName": { "type": "string", "maxLength": 200 },
    "reportTitle": { "type": "string", "maxLength": 200 },
    "periodLabelAd": { "type": "string", "maxLength": 200 },
    "periodLabelBs": { "type": "string", "maxLength": 200 },
    "scopeLabel": { "type": "string", "maxLength": 200 },
    "generatedAtLocal": { "type": "string", "maxLength": 200 },
    "exportId": { "type": "string", "format": "uuid", "maxLength": 200 },
    "exportedBy": { "type": "string", "maxLength": 200 },
    "freshnessNote": { "type": "string", "maxLength": 200 },
    "notStatutoryNote": { "type": "string", "maxLength": 200 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "kind"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "label": { "type": "string", "maxLength": 200 },
          "kind": { "enum": ["text", "count", "paisa", "seconds", "bp"] }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "integer" }] }
      }
    }
  }
}
