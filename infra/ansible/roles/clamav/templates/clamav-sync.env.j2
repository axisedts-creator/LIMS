# Managed by Ansible, role clamav. Read by lims-freshclam.service and lims-clamav-sync.service.
CLAMAV_DB_DEST={{ clamav_sync_user }}@{{ hostvars[groups['app'][0]].wg_ip }}:/
CLAMAV_SSH_PORT={{ clamav_sync_port }}
CLAMAV_RELOAD_CMD=ssh -p {{ clamav_sync_port }} -i /run/lims/secrets/clamav_sync/ssh_key -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/lims/clamav_sync_known_hosts {{ clamav_sync_user }}@{{ hostvars[groups['app'][0]].wg_ip }} reload
