[Unit]
Description=LIMS copy of the ClamAV signatures to the app host + clamd RELOAD (also the manual-import path, F-01 refused)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lims/clamav-sync.env
ExecStart=/usr/local/lib/lims/bin/lims-clamav-sync.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
