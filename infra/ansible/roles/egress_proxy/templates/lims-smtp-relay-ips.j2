#!/usr/bin/env bash
# Managed by Ansible, role egress_proxy (02-TRD s5.5 rule 5 [CONV]):
# resolve {{ smtp_relay_fqdn }} into nftables set inet filter smtp_relay_ips.
# New IPs are added before stale ones are deleted (no empty window). No
# answer = keep the old set and fail (unit failure visible in the journal).
set -euo pipefail
SET="inet filter smtp_relay_ips"
re='^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
new=$(getent ahostsv4 {{ smtp_relay_fqdn | quote }} | awk '{print $1}' | sort -u)
[ -n "$new" ] || { echo "no A record for {{ smtp_relay_fqdn }}" >&2; exit 1; }
for ip in $new; do [[ $ip =~ $re ]] || { echo "bad address $ip" >&2; exit 1; }; done
nft add element $SET "{ $(echo $new | tr ' ' ',') }"
old=$(nft list set $SET | grep -oE '([0-9]+\.){3}[0-9]+' | sort -u)
stale=$(comm -23 <(echo "$old") <(echo "$new") | grep -E "$re" || true)
[ -z "$stale" ] || nft delete element $SET "{ $(echo $stale | tr ' ' ',') }"
