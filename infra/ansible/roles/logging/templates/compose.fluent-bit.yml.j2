# 02-TRD s10.1: Fluent Bit on {{ inventory_hostname }} (compose project `logging`).
# Host network: the only listener is the metrics endpoint on {{ wg_ip }}:2020
# (fluent-bit.conf, HTTP_Listen); nothing is published on any other address.
name: logging
services:
  fluent-bit:
    image: {{ logging_images.fluent_bit }}
    network_mode: host
    restart: unless-stopped
    mem_limit: 256m
    read_only: true
    user: "0:0"
    cap_drop:
      - ALL
    # read root-owned journal files (group systemd-journal) without being root-capable otherwise
    cap_add:
      - DAC_READ_SEARCH
    security_opt:
      - no-new-privileges:true
    command:
      - /fluent-bit/bin/fluent-bit
      - -c
      - /fluent-bit/etc/fluent-bit.conf
    volumes:
      - {{ logging_etc }}/fluent-bit.conf:/fluent-bit/etc/fluent-bit.conf:ro
      - {{ logging_etc }}/parsers.conf:/fluent-bit/etc/parsers.conf:ro
      - {{ logging_etc }}/scrub.lua:/fluent-bit/etc/scrub.lua:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/log/journal:/var/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
{% if 'app' in group_names %}
      - /var/log/nginx:/var/log/nginx:ro
{% endif %}
      - {{ logging_fluent_state }}:/var/lib/fluent-bit
