# 02-TRD s3.3: ops nginx on ops-1, wg IP :443 only. TLS from the internal
# CA (roles/internal_ca), basic auth from secret ops_nginx_basic_auth
# (htpasswd on tmpfs). Fronts Grafana, Alertmanager, Prometheus, VictoriaLogs
# (all on 127.0.0.1, host network).
server_tokens off;

server {
    listen {{ wg_ip }}:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    auth_basic "LIMS ops";
    auth_basic_user_file /run/secrets/ops_nginx_htpasswd;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = / {
        return 302 /grafana/;
    }

    # Grafana does its own login (local users, s11.5): do not forward the
    # ops basic-auth header to it.
    location /grafana/ {
        proxy_set_header Authorization "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_pass http://127.0.0.1:3000;
    }

    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090/;
    }

    location /alertmanager/ {
        proxy_pass http://127.0.0.1:9093/;
    }

    # VictoriaLogs (logging task) on 127.0.0.1:9428.
    location /victorialogs/ {
        proxy_pass http://127.0.0.1:9428/;
    }

    location / {
        return 404;
    }
}
