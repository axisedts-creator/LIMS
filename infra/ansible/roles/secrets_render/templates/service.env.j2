# secrets_render (02-TRD s8.3): tmpfs, root 0400, never committed.
{% for k, e in secrets_render_here.items() if e.exposure | default('file') == 'env' and item in e.services %}
{{ e.env_name | default(k) }}='{{ e.env_format | default('%s') | format(secrets_render_values[k]) }}'
{% endfor %}
{% if item == secrets_render_fixed_env_service %}
