# Managed by Ansible (infra/database/postgresql/zz-lims.conf.j2) - 02-TRD s7.7.
# Mounted into the image conf.d directory; zz- prefix sorts last so these values win.
# Config is code (never changed at runtime). shared_preload_libraries stays the image default.

max_connections = 200
shared_buffers = 8GB
effective_cache_size = 22GB
work_mem = 16MB
maintenance_work_mem = 1GB
random_page_cost = 1.1
effective_io_concurrency = 200

wal_level = logical
wal_compression = zstd
max_wal_size = 4GB
min_wal_size = 1GB
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9
archive_mode = on
archive_timeout = '{{ archive_timeout_s }}s'
archive_command = 'pgbackrest --stanza=lims archive-push %p'
max_wal_senders = 10
max_replication_slots = 10
max_slot_wal_keep_size = 50GB
wal_keep_size = 2GB

idle_in_transaction_session_timeout = 60s

# Bind parameters may carry PHI: never log them (REQ-SEC-098, CV s9.2).
log_min_duration_statement = 1000
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_statement = 'none'
auto_explain.log_min_duration = -1
log_line_prefix = '%m [%p] %q%u@%d '

password_encryption = 'scram-sha-256'
# wg0 (WireGuard) encrypts host-to-host traffic (02-TRD s7.7 DECISION).
ssl = off
