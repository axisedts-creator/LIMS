# Managed by Ansible (infra/database/standby/standby.conf.j2) - 02-TRD s7.7, s9.5; role standby (T-12).
# Physical streaming standby on the dr host (dr-1 in profile `full`). LD-45: profile `lean` has no
# hot standby, the role renders nothing there. Seeded once by pg_basebackup as lims_replicator over
# wg0 (CR-C1-T09 option (a)): streaming only, no archive fetch, no key material on dr-1 (AC-12.3).
# Gaps after a slot invalidation are closed by re-seeding (03-APP-FLOW s3.3).
# The primary is groups['data'][0], never db_primary_wg_ip (after a promotion that var points here).

primary_conninfo = 'host={{ hostvars[groups['data'][0]].wg_ip }} port={{ standby_primary_port | default(5432) }} user=lims_replicator passfile=/run/lims/secrets/standby/pgpass application_name=dr1'
primary_slot_name = 'dr1'
recovery_min_apply_delay = 0

hot_standby = on
# [CONV] 02-TRD s7.7: drill queries must not bloat the primary.
hot_standby_feedback = off
# Cancel conflicting standby queries after 30 s, so replay lag stays < 60 s (StandbyLagHigh).
max_standby_streaming_delay = 30s
# A cut link is noticed within 60 s; reconnect every 5 s.
wal_receiver_timeout = 60s
wal_receiver_status_interval = 10s
wal_retrieve_retry_interval = 5s

# A hot standby refuses to start below the primary's values (keep >= zz-lims.conf.j2).
max_connections = 200
max_wal_senders = 10
max_replication_slots = 10

# The standby does not archive; the primary's archive to repo2 is the guarantee (02-TRD s9.4).
archive_mode = off

idle_in_transaction_session_timeout = 60s
log_min_duration_statement = 1000
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_statement = 'none'
log_line_prefix = '%m [%p] %q%u@%d '
password_encryption = 'scram-sha-256'
# wg0 encrypts host-to-host traffic (02-TRD s7.7 DECISION).
ssl = off
