# api origin (02-TRD s6.1, s6.3, CR-C1-004): default deny; one location per entry
# of public_routes (= `routes:` of infra/edge/public-routes.yaml, generated by
# infra/ci/gen-routes.sh). Nothing is hand-added here.
{#- zone -> (burst, Retry-After override); 02-TRD s6.5. An unknown zone is an
    undefined key = render error under Ansible's strict undefined. #}
{%- set zone_table = {
      'login': [20, 60], 'otp': [20, 60], 'psession': [40, 60], 'qrverify': [9, 60],
      'agent': [200, 60], 'callback': [20, 60], 'payments': [20, none]} %}
upstream api {
    server api-a:8080 max_fails=3 fail_timeout=10s;
    server api-b:8080 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    server_name {{ origins.api }};
    ssl_certificate     /etc/nginx/certs/{{ origins.api }}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/{{ origins.api }}/privkey.pem;
    include /etc/nginx/snippets/server.conf;
    proxy_set_header X-Lims-Background "";   # stripped on the api origin (08 A25 D-206)
    add_header X-Robots-Tag "noindex, nofollow" always;   # [CONV]; adds to the server-level headers.conf set

    location / {
        return 404;
    }
{% for r in public_routes %}
{%- set z = r.zone if r.zone not in (none, '', 'none') else none %}

    location {{ '=' if r.match == 'exact' else '^~' }} {{ r.path }} {
{%- if z == 'payments' %}
        # CR-C15-008 item 2: GET/HEAD only; any body -> 413 (client_max_body_size 0 = unlimited, not used).
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($http_content_length ~ "^0*[1-9]") { return 413; }
        if ($http_transfer_encoding != "") { return 413; }
{%- endif %}
{%- if z is not none %}
        limit_req zone={{ z }} burst={{ zone_table[z][0] }} nodelay;
        limit_req zone=perip burst=200 nodelay;  # TRD s6.5 "every server": location limit_req replaces the server one
{%- if zone_table[z][1] is not none %}
        set $retry_after {{ zone_table[z][1] }};
{%- endif %}
{%- endif %}
{%- if r.body_limit %}
        client_max_body_size {{ r.body_limit }};
{%- endif %}
{%- if z == 'payments' %}
        include /etc/nginx/snippets/headers-payments.conf;
{%- else %}
        include /etc/nginx/snippets/headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
{%- endif %}
        proxy_pass http://api;
    }
{%- endfor %}
}

# 02-TRD s6.9: internal listener on the app host's wg IP; health + stub_status,
# only from the ops host (LD-45: both from the active profile's inventory).
server {
    listen {{ wg_ip }}:8090;
    allow {{ hostvars[groups['ops'][0]].wg_ip }};
    deny all;
    include /etc/nginx/snippets/proxy.conf;

    location = /v1/core/health/live {
        proxy_pass http://api;
    }
    location = /v1/core/health/ready {
        proxy_pass http://api;
    }
    location = /nginx_status {
        stub_status;
    }
    location / {
        return 404;
    }
}
