{
  "uid": "lims-d01-platform-overview",
  "title": "D1 Platform overview",
  "description": "04-UI-UX s3 D1. One screen: is anything broken, is RPO safe, is the last restore drill recent. Prometheus only; no PHI (07-SECURITY).",
  "tags": [
    "lims",
    "ops",
    "c1"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Kathmandu",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "host",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
          "format": "table",
          "instant": true
        }
      ],
      "description": "Everything firing now, by severity.",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up == 0) or vector(0)"
        }
      ],
      "description": "Scrape targets with up == 0 (TargetDown pages for site A).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "gauge",
      "title": "RPO: newest WAL age in the site-B repo (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lims_ops_wal_repo2_newest_age_seconds and on() lims_ops_wal_unarchived_bytes > 0"
        }
      ],
      "description": "Warn at 600 s (WalArchiveLagging), page at 840 s (RpoAtRisk). Idle database: no data is healthy.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 600
              },
              {
                "color": "red",
                "value": 840
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Last restore drill age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - lims_ops_restore_drill_last_success_timestamp_seconds"
        }
      ],
      "description": "Warn at 35 d (3024000 s), page at 40 d (RestoreDrillOverdue).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3024000
              },
              {
                "color": "red",
                "value": 3456000
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Off-site archive configured",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lims_ops_offsite_archive_configured"
        }
      ],
      "description": "0 pages NoOffsiteArchive after 5 min: no healthy pgBackRest repo on a site other than the primary's.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NoOffsiteArchive"
                },
                "1": {
                  "text": "OK"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Up by job",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (job) (up == 1)",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Healthy targets per job.",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
