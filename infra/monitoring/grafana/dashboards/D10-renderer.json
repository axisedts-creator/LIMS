{
  "uid": "lims-d10-renderer",
  "title": "D10 Renderer and PDF sandbox",
  "description": "04-UI-UX s3 D10 (C6 renderer, pdf-sandbox). Prometheus only; no PHI (07-SECURITY).",
  "tags": [
    "lims",
    "ops",
    "c1"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Kathmandu",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Container health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lims_ops_container_health{name=~\"renderer|pdf-sandbox\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "1 = healthy.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Renderer memory vs 1.5 GiB limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_usage_bytes{name=~\".*renderer.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "mem_limit 1.5 GiB = 1610612736 bytes.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1610612736
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "pdf-sandbox memory vs 512 MiB limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_usage_bytes{name=~\".*pdf-sandbox.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "mem_limit 512 MiB = 536870912 bytes.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 536870912
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Render failures (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lims_reporting_render_failures_total[1h]))",
          "legendFormat": "failures"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Sandbox rejections (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lims_reporting_sandbox_rejections_total[1h]))",
          "legendFormat": "rejections"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Renderer counters (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"lims_renderer_.*_total\"}[5m])) * 60",
          "legendFormat": "{{__name__}}"
        }
      ],
      "description": "Re-exported through the worker /metrics (08 A27.3).",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
