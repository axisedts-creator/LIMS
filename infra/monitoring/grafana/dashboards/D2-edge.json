{
  "uid": "lims-d02-edge",
  "title": "D2 Edge",
  "description": "04-UI-UX s3 D2 (nginx edge, TLS, fail2ban, Squid egress). Prometheus only; no PHI (07-SECURITY).",
  "tags": [
    "lims",
    "ops",
    "c1"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Kathmandu",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests by status class (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(lims_ops_edge_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections by zone (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(lims_ops_edge_rate_limited_total{zone=~\"login|otp|psession|qrverify|agent|callback|payments|perip\"}[5m]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "description": "Zones: login, otp, psession, qrverify, agent, callback, payments, perip (02-TRD s5).",
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Highest per-client 404 count (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lims_ops_edge_not_found_max_per_ip_5m",
          "legendFormat": "max per client"
        }
      ],
      "description": "EdgeNotFoundSpike warns above 30 for 15 min; the client address is only in the logs.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "fail2ban bans per hour by jail",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jail) (increase(lims_ops_fail2ban_bans_total[1h]))",
          "legendFormat": "{{jail}}"
        }
      ],
      "description": "Fail2banBanSpike warns above 50 per hour.",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Days until certificate expiry",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(probe_ssl_earliest_cert_expiry) - time()) / 86400"
        }
      ],
      "description": "Warn under 21 days, page under 7.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Squid denied egress by dest_class",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dest_class) (increase(lims_ops_egress_denied_total[1h]))",
          "legendFormat": "{{dest_class}}"
        }
      ],
      "description": "EgressDenied warns on any increase.",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
