{
  "uid": "lims-d03-api",
  "title": "D3 API",
  "description": "04-UI-UX s3 D3 (lims_http_*, C0 metrics). Prometheus only; no PHI (07-SECURITY).",
  "tags": [
    "lims",
    "ops",
    "c1"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Kathmandu",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "host",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests by route class (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(lims_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lims_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "RLS denials (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lims_rls_denied_total[5m])) * 60",
          "legendFormat": "denied"
        }
      ],
      "description": "RlsDenied page at 5x the 7-day baseline (core.rules.yml).",
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Auth failures by reason (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(lims_core_auth_failures_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections by bucket (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bucket) (rate(lims_ratelimit_rejections_total[5m])) * 60",
          "legendFormat": "{{bucket}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "API targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{service=~\"api.*\"} == 1) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
