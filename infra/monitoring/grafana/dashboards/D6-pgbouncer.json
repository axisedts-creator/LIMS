{
  "uid": "lims-d06-pgbouncer",
  "title": "D6 PgBouncer",
  "description": "04-UI-UX s3 D6. Prometheus only; no PHI (07-SECURITY).",
  "tags": [
    "lims",
    "ops",
    "c1"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Kathmandu",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "host",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Client connections active",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (database) (pgbouncer_pools_client_active_connections)",
          "legendFormat": "{{database}}"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Client connections waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (database) (pgbouncer_pools_client_waiting_connections)",
          "legendFormat": "{{database}}"
        }
      ],
      "description": "PgBouncerWaiting warns when above 0 for 2 min.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Server connections active",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (database) (pgbouncer_pools_server_active_connections)",
          "legendFormat": "{{database}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Server connections idle",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (database) (pgbouncer_pools_server_idle_connections)",
          "legendFormat": "{{database}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    }
  ]
}
