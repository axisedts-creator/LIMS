{
  "name": "@lims/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.live.test.*\" --exclude \"**/*.integration.test.*\" --exclude \"**/integration/**\" --exclude \"**/probes/**\" --exclude \"**/isolation/**\" --exclude \"**/perf/**\" --exclude \"**/e2e/**\"",
    "test:integration": "vitest run .live.test. .integration.test. /integration/ --passWithNoTests"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "playwright": "1.65.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
