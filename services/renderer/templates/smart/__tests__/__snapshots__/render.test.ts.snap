// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots — reviewed fragment per fixture (AD, Asia/Kathmandu) > approved 1`] = `"<section class="smart-section"><h2 class="smart-title">Smart summary</h2><p class="smart-notice">This summary is prepared from your approved laboratory results using rules approved by the laboratory&#39;s pathologist. It is not a diagnosis or a prescription. Please discuss your results with your doctor.</p><div class="smart-score"><strong>Health score (not a diagnosis)</strong><span class="smart-score-value">72 / 100</span><span class="smart-score-band">Fair</span><span>Based on 4 body systems</span><span>SYNTH-EXPLAIN The score reflects how many body systems are in range.</span></div><ul class="smart-tiles"><li class="smart-tile smart-status-in_range"><span class="smart-tile-name">SYNTH Blood count</span> <span class="smart-tile-status">In range</span></li><li class="smart-tile smart-status-borderline"><span class="smart-tile-name">SYNTH Fat profile</span> <span class="smart-tile-status">Borderline</span></li><li class="smart-tile smart-status-out_of_range"><span class="smart-tile-name">SYNTH Sugar</span> <span class="smart-tile-status">Out of range</span></li><li class="smart-tile smart-status-critical"><span class="smart-tile-name">SYNTH Minerals</span> <span class="smart-tile-status">Critical</span></li></ul><h3 class="smart-subtitle">Results outside the reference range</h3><ul class="smart-list"><li><strong>Glucose</strong> <span>High</span> <span>Out of range</span> <span>SYNTH-FIND-1 Your sugar is higher than the reference range.</span></li><li><strong>Potassium</strong> <span>Low</span> <span>Critical</span> <span>SYNTH-FIND-2 Your potassium is lower than the reference range.</span></li><li><strong>Urine colour</strong> <span>Abnormal</span> <span>Borderline</span> <span>SYNTH-FIND-3 One result is not in its usual form.</span></li></ul><h3 class="smart-subtitle">Your results over time</h3><table class="smart-trends"><thead><tr><th scope="col">Result</th><th scope="col">Unit</th><th scope="col">Values, oldest to newest</th><th scope="col">Trend</th></tr></thead><tbody><tr><td>Glucose</td><td>mg&#47;dL</td><td><span>02&#47;11&#47;2025: 15.0</span> <span>03&#47;05&#47;2026: 10.50</span> <span>05&#47;11&#47;2026: 5.60</span></td><td>Improved</td></tr></tbody></table><h3 class="smart-subtitle">Suggestions</h3><ul class="smart-list"><li>SYNTH-ADVICE-1 Eat regular balanced meals.</li><li>SYNTH-ADVICE-2 Walk every day.</li></ul><h3 class="smart-subtitle">Tests your doctor may consider</h3><ul class="smart-list"><li>SYNTH-FOLLOW-1 Repeat the sugar control test. (Glycated haemoglobin, after 90 days)</li></ul><p class="smart-disclaimer">SYNTH-DISCLAIMER This summary does not replace advice from your own doctor.</p><p class="smart-meta">Reviewed and approved by the laboratory's pathologist on 05&#47;11&#47;2026. Summary library version lib-SYN-1; score formula score-SYN-1.</p></section>"`;

exports[`snapshots — reviewed fragment per fixture (AD, Asia/Kathmandu) > devanagari 1`] = `"<section class="smart-section"><h2 class="smart-title">Smart summary</h2><p class="smart-notice">This summary is prepared from your approved laboratory results using rules approved by the laboratory&#39;s pathologist. It is not a diagnosis or a prescription. Please discuss your results with your doctor.</p><div class="smart-score"><strong>Health score (not a diagnosis)</strong><span class="smart-score-value">72 / 100</span><span class="smart-score-band">Fair</span><span>Based on 4 body systems</span><span><span lang="ne">यो अङ्कले कति शारीरिक प्रणाली सामान्य सीमामा छन् भन्ने देखाउँछ।</span></span></div><ul class="smart-tiles"><li class="smart-tile smart-status-in_range"><span class="smart-tile-name"><span lang="ne">रगतको जाँच</span></span> <span class="smart-tile-status">In range</span></li><li class="smart-tile smart-status-out_of_range"><span class="smart-tile-name"><span lang="ne">चिनीको जाँच</span></span> <span class="smart-tile-status">Out of range</span></li></ul><h3 class="smart-subtitle">Results outside the reference range</h3><ul class="smart-list"><li><strong><span lang="ne">ग्लुकोज</span></strong> <span>High</span> <span>Out of range</span> <span><span lang="ne">तपाईंको चिनीको मात्रा सामान्य सीमाभन्दा बढी छ।</span></span></li></ul><h3 class="smart-subtitle">Your results over time</h3><table class="smart-trends"><thead><tr><th scope="col">Result</th><th scope="col">Unit</th><th scope="col">Values, oldest to newest</th><th scope="col">Trend</th></tr></thead><tbody><tr><td><span lang="ne">Glucose</span></td><td><span lang="ne">mg&#47;dL</span></td><td><span>02&#47;11&#47;2025: 15.0</span> <span>03&#47;05&#47;2026: 10.50</span> <span>05&#47;11&#47;2026: 5.60</span></td><td>Improved</td></tr></tbody></table><h3 class="smart-subtitle">Suggestions</h3><ul class="smart-list"><li><span lang="ne">नियमित सन्तुलित खाना खानुहोस्।</span></li></ul><h3 class="smart-subtitle">Tests your doctor may consider</h3><ul class="smart-list"><li><span lang="ne">चिनी नियन्त्रणको जाँच दोहोर्याउनुहोस्।</span> (<span lang="ne">ग्लाइकेटेड हेमोग्लोबिन</span>, after 90 days)</li></ul><p class="smart-disclaimer"><span lang="ne">यो सारांशले तपाईंको चिकित्सकको सल्लाहलाई प्रतिस्थापन गर्दैन।</span></p><p class="smart-meta">Reviewed and approved by the laboratory's pathologist on 05&#47;11&#47;2026. Summary library version lib-SYN-1; score formula score-SYN-1.</p></section>"`;

