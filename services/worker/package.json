{
  "name": "@lims/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --import ../../tools/node-ts/register.mjs src/main.ts",
    "registry-sync": "node --import ../../tools/node-ts/register.mjs src/core/registry-sync.ts",
    "worker:replay": "node --import ../../tools/node-ts/register.mjs src/core/replay.ts",
    "test:unit": "vitest run --exclude \"**/*.live.test.*\" --exclude \"**/*.integration.test.*\" --exclude \"**/integration/**\" --exclude \"**/probes/**\" --exclude \"**/isolation/**\" --exclude \"**/perf/**\" --exclude \"**/e2e/**\"",
    "test:integration": "vitest run .live.test. .integration.test. /integration/ --passWithNoTests"
  },
  "dependencies": {
    "@lims/shared-ts": "workspace:*",
    "ajv": "8.20.0",
    "graphile-worker": "0.18.0",
    "pg": "8.23.1",
    "read-excel-file": "9.3.14",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
